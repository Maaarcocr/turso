# numeric arithmetic and comparisons through the PostgreSQL frontend.
#
# Every expected value matches PostgreSQL itself.

@database :memory:

test numeric-arithmetic-on-typed-subexpressions {
    CREATE TABLE t (p numeric(20,2), i integer);
    INSERT INTO t VALUES ('12345678901234567.89', 3);
    SELECT (p + 1) + 2, p + i FROM t;
}
expect {
    12345678901234570.89|12345678901234570.89
}

test numeric-plus-double-precision-is-double-precision {
    CREATE TABLE t (p numeric(10,2), r double precision);
    INSERT INTO t VALUES ('0.10', 0.2);
    SELECT CASE WHEN p + r = 0.3 THEN 'numeric' ELSE 'double precision' END FROM t;
}
expect {
    double precision
}

test numeric-compared-with-literals {
    CREATE TABLE t (p numeric(5,2), q numeric(5,0));
    INSERT INTO t VALUES ('1.55', '2');
    SELECT q * 1.5 FROM t;
    SELECT count(*) FROM t WHERE p < 1.555;
    SELECT count(*) FROM t WHERE p = 1.555;
    SELECT count(*) FROM t WHERE p < 100000;
}
expect {
    3.0
    1
    0
    1
}

test numeric-equality-index-and-scan-agree {
    CREATE TABLE t (p numeric(5,2));
    CREATE INDEX t_p ON t (p);
    INSERT INTO t VALUES ('1.55'), ('1.56');
    SELECT count(*) FROM t WHERE p = 1.555;
    SELECT count(*) FROM t WHERE p = 1.56;
}
expect {
    0
    1
}

test numeric-division-keeps-at-least-16-significant-digits {
    CREATE TABLE t (p numeric(5,2), d numeric(5,3), one numeric(2,1));
    INSERT INTO t VALUES ('1.55', '0.001', '1.0');
    SELECT p / 3, p / d, one / (p * 10000) FROM t;
}
expect {
    0.51666666666666666667|1550.0000000000000000|0.000064516129032258064516
}

test numeric-in-case-and-nullif-compare-as-numbers {
    CREATE TABLE t (p numeric(10,2), q numeric(10,0));
    INSERT INTO t VALUES ('2.00', '10');
    SELECT count(*) FROM t WHERE p IN (2);
    SELECT count(*) FROM t WHERE p IN (3, 2);
    SELECT count(*) FROM t WHERE p NOT IN (2);
    SELECT CASE p WHEN 2 THEN 'yes' ELSE 'no' END FROM t;
    SELECT count(*) FROM t WHERE nullif(p, 2) IS NULL;
    SELECT nullif(p, 3) FROM t;
}
expect {
    1
    1
    0
    yes
    1
    2.00
}

test numeric-coalesce-and-case-keep-numeric {
    CREATE TABLE t (p numeric(10,2));
    INSERT INTO t VALUES ('2.00'), (NULL);
    SELECT coalesce(p, 0) + 1, CASE WHEN p > 0 THEN p ELSE 0 END + 1 FROM t ORDER BY 1;
}
expect {
    1|1
    3.00|3.00
}

test numeric-join-compares-as-numbers {
    CREATE TABLE a (q numeric(10,0));
    CREATE TABLE b (y numeric(10,1));
    INSERT INTO a VALUES ('10'), ('20');
    INSERT INTO b VALUES ('10.0'), ('30.0');
    SELECT a.q, b.y FROM a JOIN b ON a.q = b.y;
}
expect {
    10|10.0
}

test numeric-expressions-sort-as-numbers {
    CREATE TABLE t (p numeric(10,2));
    INSERT INTO t VALUES ('9.00'), ('10.00');
    SELECT max(p * 1), min(p * 1) FROM t;
    SELECT p FROM t ORDER BY p * 1 DESC;
}
expect {
    10.00|9.00
    10.00
    9.00
}

test numeric-distinct-ignores-scale {
    CREATE TABLE t (id integer, p numeric(10,2), q numeric(10,1));
    INSERT INTO t VALUES (1, '2.00', '9.0'), (2, '7.00', '2.0');
    SELECT count(DISTINCT CASE WHEN id = 1 THEN p ELSE q END) FROM t;
    SELECT count(*) FROM (SELECT DISTINCT CASE WHEN id = 1 THEN p ELSE q END FROM t) s;
}
expect {
    1
    1
}

test numeric-group-by-ignores-scale {
    CREATE TABLE t (id integer, p numeric(10,2), q numeric(10,1));
    INSERT INTO t VALUES (1, '2.00', '9.0'), (2, '7.00', '2.0'), (3, '2.00', '1.0');
    SELECT count(*) FROM t GROUP BY CASE WHEN id = 2 THEN q ELSE p END ORDER BY 1;
}
expect {
    3
}

test numeric-in-subquery-compares-as-numbers {
    CREATE TABLE a (q numeric(10,0));
    CREATE TABLE b (y numeric(10,1));
    INSERT INTO a VALUES ('10'), ('20');
    INSERT INTO b VALUES ('10.0'), ('30.0');
    SELECT q FROM a WHERE q IN (SELECT y FROM b);
    SELECT q FROM a WHERE q NOT IN (SELECT y FROM b);
}
expect {
    10
    20
}

test numeric-union-intersect-except-compare-as-numbers {
    CREATE TABLE a (p numeric(10,2));
    INSERT INTO a VALUES ('2.00');
    CREATE TABLE b (y numeric(10,1));
    INSERT INTO b VALUES ('2.0'), ('3.0');
    SELECT * FROM (SELECT p FROM a UNION SELECT y FROM b) s ORDER BY 1;
    SELECT * FROM (SELECT y FROM b INTERSECT SELECT p FROM a) s;
    SELECT * FROM (SELECT y FROM b EXCEPT SELECT p FROM a) s;
}
expect {
    2.00
    3.0
    2.0
    3.0
}

test numeric-negation-and-abs-keep-numeric {
    CREATE TABLE t (p numeric(10,2));
    INSERT INTO t VALUES ('1.50'), ('-2.25');
    SELECT -p, abs(p), -(p * 1) + 1 FROM t ORDER BY 1;
}
expect {
    -1.50|1.50|-0.50
    2.25|2.25|3.25
}
