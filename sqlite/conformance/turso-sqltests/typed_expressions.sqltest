@requires strict "uses STRICT tables"
test nested-compound-subqueries-are-typed-quickly {
    CREATE TABLE t1(a INTEGER, b INTEGER, c INTEGER, p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, 2, 3, '1.50');
    SELECT count(*), max(a), max(p) FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM (SELECT a, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1) UNION SELECT a + 1, b, c, p FROM t1);
}
expect {
    2|2|1.50
}

@requires strict "uses STRICT tables"
test scalar-subqueries-and-aggregate-min-max-have-the-type-of-their-value {
    CREATE TABLE t1(g INTEGER, p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, '1.50'), (1, '10.00'), (2, '20.00'), (3, '100.00');
    SELECT (SELECT min(p) FROM t1) > 9.5, (SELECT max(p) FROM t1) + 1;
    SELECT g FROM t1 GROUP BY g HAVING min(p) < 2;
    SELECT g, max(p) FROM t1 GROUP BY g ORDER BY max(p);
    SELECT max(p) + 1, typeof(max(p) + 1) FROM t1;
}
expect {
    0|101.00
    1
    1|10.00
    2|20.00
    3|100.00
    101.00|text
}

@requires strict "uses STRICT tables"
test recursive-cte-converts-recursive-rows-to-the-anchor-type {
    CREATE TABLE t1(q numeric) STRICT;
    INSERT INTO t1 VALUES ('0.10000000000000000001');
    WITH RECURSIVE r(x) AS (SELECT q FROM t1 UNION ALL SELECT x * 2 FROM r WHERE x < 1) SELECT x, typeof(x) FROM r;
}
expect {
    0.10000000000000000001|text
    0.20000000000000000002|text
    0.40000000000000000004|text
    0.80000000000000000008|text
    1.60000000000000000016|text
}

@requires strict "uses STRICT tables"
test recursive-cte-union-removes-rows-with-equal-keys {
    CREATE TABLE t1(q numeric) STRICT;
    INSERT INTO t1 VALUES ('1');
    WITH RECURSIVE r(x) AS (SELECT q FROM t1 UNION SELECT x * 1.0 FROM r) SELECT x FROM r;
}
expect {
    1
}

@requires strict "uses STRICT tables"
test domains-use-the-operators-of-their-base-type {
    CREATE DOMAIN price AS numeric;
    CREATE DOMAIN day AS date;
    CREATE TABLE t1(id INTEGER PRIMARY KEY, d price, e day) STRICT;
    INSERT INTO t1 VALUES (1, '9.00', '2024-01-05'), (2, '10.00', '2024-01-06'), (3, '1.5', '2024-01-07');
    SELECT d FROM t1 ORDER BY d;
    SELECT id FROM t1 WHERE d = 1.5;
    SELECT d * 2, d + 1 FROM t1 ORDER BY id;
    SELECT id FROM t1 WHERE d < 9.5 ORDER BY id;
    SELECT e + 1 FROM t1 WHERE id = 1;
}
expect {
    1.5
    9
    10
    3
    18|10
    20|11
    3.0|2.5
    1
    3
    2024-01-06
}

@requires strict "uses STRICT tables"
test in-subquery-compares-with-the-type-of-the-subquery-column {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(10,2), q numeric) STRICT;
    INSERT INTO t1 VALUES (1, '1.50', '1.5'), (2, '2.00', '2');
    SELECT 1.5 IN (SELECT p FROM t1), 3 IN (SELECT p FROM t1), 1.5 NOT IN (SELECT p FROM t1);
    SELECT id, (p, 1) IN (SELECT q, 1 FROM t1) FROM t1 ORDER BY id;
    SELECT id FROM t1 WHERE p IN (SELECT q FROM t1 UNION SELECT 7) ORDER BY id;
}
expect {
    1|0|0
    1|1
    2|1
    1
    2
}

@requires strict "uses STRICT tables"
test in-subquery-on-an-indexed-varchar-column-seeks-the-index {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, v varchar(10)) STRICT;
    CREATE INDEX t1v ON t1(v);
    INSERT INTO t1 VALUES (1, 'a'), (2, 'b');
    CREATE TABLE t2(w varchar(10)) STRICT;
    INSERT INTO t2 VALUES ('b');
    EXPLAIN QUERY PLAN SELECT id FROM t1 WHERE v IN (SELECT w FROM t2);
    SELECT id FROM t1 WHERE v IN (SELECT w FROM t2);
}
expect {
    1|0|0|LIST SUBQUERY 1
    4|1|0|SCAN t2
    14|0|0|SEARCH t1 USING COVERING INDEX t1v (v=?)
    2
}

@requires strict "uses STRICT tables"
test group-by-and-partition-by-sort-by-the-type-key {
    CREATE TYPE citext(value text) BASE text ENCODE value DECODE value KEY lower(value) OPERATOR '<';
    CREATE TABLE t1(id INTEGER PRIMARY KEY, c citext) STRICT;
    INSERT INTO t1 VALUES (1, 'A'), (2, 'B'), (3, 'a'), (4, 'b'), (5, 'A');
    SELECT c, count(*) FROM t1 GROUP BY c;
    SELECT count(DISTINCT c) FROM t1;
    SELECT id, count(*) OVER (PARTITION BY c) FROM t1 ORDER BY id;
}
expect {
    A|3
    B|2
    2
    1|3
    2|2
    3|3
    4|2
    5|3
}

@requires strict "uses STRICT tables"
test check-constraints-compare-typed-values-with-the-type-operators {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(10,2) CHECK (p > 0), q numeric(10,2), CHECK (q < p * 2)) STRICT;
    INSERT INTO t1 VALUES (1, '1.50', '2.99');
    INSERT INTO t1 VALUES (2, '0.01', NULL);
    SELECT id, p, q FROM t1 ORDER BY id;
}
expect {
    1|1.50|2.99
    2|0.01|
}

@requires strict "uses STRICT tables"
test check-constraint-on-a-typed-comparison-refuses-rows {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(10,2) CHECK (p > 0)) STRICT;
    INSERT INTO t1 VALUES (1, '-1.00');
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test check-constraint-with-a-typed-product-refuses-rows {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(10,2), q numeric(10,2), CHECK (q < p * 2)) STRICT;
    INSERT INTO t1 VALUES (1, '1.50', '3.00');
}
expect error {
    CHECK constraint failed
}

@requires strict "uses STRICT tables"
test check-constraint-still-refuses-integer-compared-with-text {
    CREATE TABLE t1(a INTEGER CHECK (a > 'x')) STRICT;
}
expect error {
    type mismatch in CHECK constraint: cannot compare INTEGER with TEXT
}

@requires strict "uses STRICT tables"
test sum-and-avg-of-numeric-are-exact {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(10,2), r REAL) STRICT;
    INSERT INTO t1 VALUES (1, '1.10', 1.10), (2, '2.20', 2.20), (3, '0.01', 0.01), (4, NULL, NULL);
    SELECT sum(p), avg(p), typeof(avg(r)), count(p) FROM t1;
    SELECT sum(DISTINCT p), avg(p) FILTER (WHERE id > 1) FROM t1;
    SELECT sum(p), avg(p) FROM t1 WHERE id > 10;
}
expect {
    3.31|1.10333333333333333333|real|3
    3.31|1.10500000000000000000
    |
}

@requires strict "uses STRICT tables"
test sum-and-avg-of-numeric-over-sliding-windows {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, '1.10'), (2, '2.20'), (3, '0.01');
    SELECT id, sum(p) OVER w, avg(p) OVER w FROM t1
    WINDOW w AS (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW);
}
expect {
    1|1.10|1.10000000000000000000
    2|3.30|1.6500000000000000
    3|2.21|1.10500000000000000000
}

@requires strict "uses STRICT tables"
test numeric-ranges-and-order-by-use-an-index {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(10,2), q numeric) STRICT;
    CREATE INDEX t1p ON t1(p);
    CREATE INDEX t1q ON t1(q);
    INSERT INTO t1 VALUES (1, '1.50', '1.50'), (2, '-2', '-2'), (3, '10', '10'), (4, '0.25', '0.25'), (5, NULL, NULL), (6, '9.99', '9.990'), (7, '-0.5', '-0.50'), (8, '100', '1e2');
    EXPLAIN QUERY PLAN SELECT id FROM t1 WHERE p > 1.5;
    SELECT group_concat(id) FROM (SELECT id FROM t1 WHERE p > 1.5);
    SELECT group_concat(id) FROM (SELECT id FROM t1 NOT INDEXED WHERE p > 1.5);
    SELECT group_concat(id) FROM (SELECT id FROM t1 WHERE p BETWEEN -1 AND 9.995);
    SELECT group_concat(id) FROM (SELECT id FROM t1 NOT INDEXED WHERE p BETWEEN -1 AND 9.995);
    SELECT group_concat(id) FROM (SELECT id FROM t1 WHERE q >= 1.5 AND q < 100);
    SELECT group_concat(id) FROM (SELECT id FROM t1 NOT INDEXED WHERE q >= 1.5 AND q < 100);
    EXPLAIN QUERY PLAN SELECT p FROM t1 ORDER BY p;
    SELECT group_concat(p, ' ') FROM (SELECT p FROM t1 ORDER BY p);
    SELECT group_concat(q, ' ') FROM (SELECT q FROM t1 ORDER BY q DESC);
    SELECT min(p), max(p), min(q), max(q) FROM t1;
    SELECT id FROM t1 WHERE p = 1.5;
    SELECT id FROM t1 WHERE q = 100;
}
expect {
    1|0|0|SEARCH t1 USING COVERING INDEX t1p (p>?)
    6,3,8
    3,6,8
    7,4,1,6
    1,4,6,7
    1,6,3
    1,3,6
    1|0|0|SCAN t1 USING COVERING INDEX t1p
    -2.00 -0.50 0.25 1.50 9.99 10.00 100.00
    100 10 9.99 1.5 0.25 -0.5 -2
    -2.00|100.00|-2|100
    1
    8
}

test numeric-values-are-stored-in-an-order-preserving-form {
    SELECT hex(numeric_encode('1.50', 10, 2)), hex(numeric_encode('-1.5', NULL, NULL)), hex(numeric_encode(0, NULL, NULL));
    SELECT numeric_encode('-2', NULL, NULL) < numeric_encode('-1.5', NULL, NULL), numeric_encode('9.99', NULL, NULL) < numeric_encode('10', NULL, NULL);
    SELECT numeric_decode(numeric_encode('1.50', 10, 2), 2), numeric_decode(numeric_encode('1.50', NULL, NULL), NULL), numeric_decode(numeric_encode('100', NULL, NULL));
    SELECT numeric_decode(x'010002000000000000000100000096000000', 5), numeric_decode(x'010102000000000000000100000096000000');
}
expect {
    308000000110|107FFFFFFE55FF|20
    1|1
    1.50|1.5|100
    1.50|-1.50
}
