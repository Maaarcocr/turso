@database :memory:
@requires-file custom_types "uses custom types"

@requires strict "uses STRICT tables"
test numeric-rounds-half-away-from-zero {
    CREATE TABLE t1(p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('1.505'), ('-1.505'), ('1.504'), ('2.995');
    SELECT p FROM t1;
}
expect {
    1.51
    -1.51
    1.50
    3.00
}

@requires strict "uses STRICT tables"
test numeric-rounding-can-exceed-precision {
    CREATE TABLE t1(p numeric(3,2)) STRICT;
    INSERT INTO t1 VALUES ('9.995');
}
expect error {
}

test create-type-stores-signatures-casts-functions-and-key {
    CREATE TYPE money(value any, scale integer DEFAULT NULL) BASE text ENCODE value DECODE value KEY value CAST FROM integer, real AS IMPLICIT OPERATOR '+' (money, money) RETURNS money money_add OPERATOR '-' (money) RETURNS money money_neg OPERATOR '<' (money, integer) money_lt OPERATOR '=' FUNCTION abs(money) RETURNS money money_abs;
    SELECT sql FROM sqlite_turso_types WHERE sql LIKE 'CREATE TYPE money%';
}
expect {
    CREATE TYPE money(value any, scale integer DEFAULT NULL) BASE text ENCODE value DECODE value KEY value CAST FROM integer, real AS IMPLICIT OPERATOR '+' (money, money) RETURNS money money_add OPERATOR '-' (money) RETURNS money money_neg OPERATOR '<' (money, integer) money_lt OPERATOR '=' FUNCTION abs(money) RETURNS money money_abs
}

test create-type-keeps-old-operator-syntax {
    CREATE TYPE t(value any) BASE text ENCODE value DECODE value OPERATOR '+' (t) -> t_add;
    SELECT sql FROM sqlite_turso_types WHERE sql LIKE 'CREATE TYPE t(%';
}
expect {
    CREATE TYPE t(value any) BASE text ENCODE value DECODE value OPERATOR '+' t_add
}

test create-type-rejects-unknown-signature-type {
    CREATE TYPE money(value any) BASE text OPERATOR '+' (money, no_such_type) RETURNS money money_add;
}
expect error {
}

@requires strict "uses STRICT tables"
test type-parameter-default-makes-parameter-optional {
    CREATE TYPE shortstr(value text, maxlen integer DEFAULT 3) BASE text ENCODE CASE WHEN length(value) <= maxlen THEN value ELSE RAISE(ABORT, 'too long') END DECODE value;
    CREATE TABLE t1(a shortstr, b shortstr(5)) STRICT;
    INSERT INTO t1 VALUES ('abc', 'abcde');
    SELECT a, b FROM t1;
}
expect {
    abc|abcde
}

@requires strict "uses STRICT tables"
test type-parameter-default-is-used-by-encode {
    CREATE TYPE shortstr(value text, maxlen integer DEFAULT 3) BASE text ENCODE CASE WHEN length(value) <= maxlen THEN value ELSE RAISE(ABORT, 'too long') END DECODE value;
    CREATE TABLE t1(a shortstr) STRICT;
    INSERT INTO t1 VALUES ('abcd');
}
expect error {
    too long
}

test type-parameter-default-must-be-trailing {
    CREATE TYPE pair(value any, a integer DEFAULT 1, b integer) BASE text;
}
expect error {
}

@requires strict "uses STRICT tables"
test numeric-operator-applies-to-typed-subexpressions {
    CREATE TABLE t1(p numeric(20,2), i INTEGER) STRICT;
    INSERT INTO t1 VALUES ('12345678901234567.89', 3);
    SELECT (p + 1) + 2, p + i, (p + i) * 1 FROM t1;
}
expect {
    12345678901234570.89|12345678901234570.89|12345678901234570.89
}

@requires strict "uses STRICT tables"
test numeric-literal-is-not-converted-with-column-scale {
    CREATE TABLE t1(p numeric(5,2), q numeric(5,0)) STRICT;
    INSERT INTO t1 VALUES ('1.55', '2');
    SELECT q * 1.5 FROM t1;
    SELECT p FROM t1 WHERE p < 1.555;
    SELECT count(*) FROM t1 WHERE p = 1.555;
    SELECT p FROM t1 WHERE p < 100000;
}
expect {
    3.0
    1.55
    0
    1.55
}

@requires strict "uses STRICT tables"
test numeric-result-compares-as-number {
    CREATE TABLE t1(p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('1.50');
    SELECT count(*) FROM t1 WHERE p * 1 > 5;
    SELECT p * 1 < 5 FROM t1;
}
expect {
    0
    1
}

@requires strict "uses STRICT tables"
test typed-equality-index-and-scan-agree {
    CREATE TABLE t1(p numeric(5,2), s smallint, v varchar(3)) STRICT;
    CREATE INDEX t1_p ON t1(p);
    CREATE INDEX t1_s ON t1(s);
    CREATE INDEX t1_v ON t1(v);
    INSERT INTO t1 VALUES ('1.55', 1, 'abc'), ('1.56', 2, 'abd'), ('1.50', 3, 'abe');
    SELECT 'index', count(*) FROM t1 INDEXED BY t1_p WHERE p = 1.555;
    SELECT 'scan', count(*) FROM t1 NOT INDEXED WHERE p = 1.555;
    SELECT 'index', p FROM t1 INDEXED BY t1_p WHERE p = 1.5;
    SELECT 'scan', p FROM t1 NOT INDEXED WHERE p = 1.5;
    SELECT 'index', count(*) FROM t1 INDEXED BY t1_p WHERE p = 100000;
    SELECT 'scan', count(*) FROM t1 NOT INDEXED WHERE p = 100000;
    SELECT 'index', count(*) FROM t1 INDEXED BY t1_s WHERE s = 100000;
    SELECT 'scan', count(*) FROM t1 NOT INDEXED WHERE s = 100000;
    SELECT 'index', count(*) FROM t1 INDEXED BY t1_v WHERE v = 'abcdef';
    SELECT 'scan', count(*) FROM t1 NOT INDEXED WHERE v = 'abcdef';
}
expect {
    index|0
    scan|0
    index|1.50
    scan|1.50
    index|0
    scan|0
    index|0
    scan|0
    index|0
    scan|0
}

@requires strict "uses STRICT tables"
test uuid-literal-is-converted-before-comparing {
    CREATE TABLE t1(u uuid) STRICT;
    CREATE INDEX t1_u ON t1(u);
    INSERT INTO t1 VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');
    SELECT 'index', count(*) FROM t1 INDEXED BY t1_u WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11';
    SELECT 'scan', count(*) FROM t1 NOT INDEXED WHERE u = 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11';
}
expect {
    index|1
    scan|1
}

@requires strict "uses STRICT tables"
test date-comparison-with-invalid-date-fails {
    CREATE TABLE t1(d date) STRICT;
    INSERT INTO t1 VALUES ('2024-01-05');
    SELECT count(*) FROM t1 WHERE d = 'garbage';
}
expect error {
    invalid date value
}

@requires strict "uses STRICT tables"
test date-plus-untyped-operand-adds-days {
    CREATE TABLE t1(d date) STRICT;
    INSERT INTO t1 VALUES ('2024-01-05');
    SELECT d + (SELECT 2), d + 1, d - 1 FROM t1;
}
expect {
    2024-01-07|2024-01-06|2024-01-04
}

@requires strict "uses STRICT tables"
test operator-signature-with-two-equal-candidates-is-an-error {
    CREATE TYPE money(value any) BASE text ENCODE value DECODE value OPERATOR '+' (money, integer) RETURNS money numeric_add OPERATOR '+' (money, real) RETURNS money numeric_add;
    CREATE TABLE t1(m money) STRICT;
    INSERT INTO t1 VALUES ('1');
    SELECT m + NULL FROM t1;
}
expect error {
    operator is not unique
}

@requires strict "uses STRICT tables"
test operator-signature-declared-by-user-type {
    CREATE TYPE money(value any) BASE text ENCODE value DECODE value CAST FROM integer AS IMPLICIT OPERATOR '+' (money, money) RETURNS money numeric_add OPERATOR '<' (money, money) numeric_lt;
    CREATE TABLE t1(m money, i INTEGER) STRICT;
    INSERT INTO t1 VALUES ('1.25', 2);
    SELECT (m + i) + (m + i), (m + i) < 4 FROM t1;
}
expect {
    6.50|1
}

@requires strict "uses STRICT tables"
test numeric-division-keeps-at-least-16-significant-digits {
    CREATE TABLE t1(p numeric(5,2)) STRICT;
    INSERT INTO t1 VALUES ('1.55');
    SELECT p / 3, p / 0.001, 1.0 / (p * 10000) FROM t1;
}
expect {
    0.51666666666666666667|1550.0000000000000000|0.000064516129032258064516
}

@requires strict "uses STRICT tables"
test in-case-nullif-is-and-row-values-use-the-type-equality {
    CREATE TABLE t1(p numeric(10,2), q numeric(10,0)) STRICT;
    INSERT INTO t1 VALUES ('2.00', '10');
    SELECT p IN (2), p IN (3, 2.0), p NOT IN (2), p IN (q, 5) FROM t1;
    SELECT CASE p WHEN 2 THEN 'yes' ELSE 'no' END FROM t1;
    SELECT nullif(p, 2) IS NULL, nullif(p, 3) FROM t1;
    SELECT p IS 2, p IS NOT 2, p IS NULL FROM t1;
    SELECT (p, q) = (2, 10), (p, q) < (2, 11), (p, q) IN ((2, 10)) FROM t1;
    SELECT count(*) FROM t1 WHERE p IN (2, 3);
    SELECT count(*) FROM t1 WHERE p IS 2;
    SELECT count(*) FROM t1 WHERE (p, q) = (2, 10);
}
expect {
    1|1|0|0
    yes
    1|2.00
    1|0|0
    1|1|1
    1
    1
    1
}

@requires strict "uses STRICT tables"
test scalar-min-max-use-the-type-order {
    CREATE TABLE t1(p numeric(10,2), q numeric(10,0)) STRICT;
    INSERT INTO t1 VALUES ('2.00', '10');
    SELECT max(p, q), min(p, q), max(p, 1), min(p, 3), max(p, NULL) IS NULL FROM t1;
}
expect {
    10|2.00|2.00|2.00|1
}

@requires strict "uses STRICT tables"
test coalesce-iif-and-case-results-have-the-branch-type {
    CREATE TABLE t1(p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('2.00'), (NULL);
    SELECT coalesce(p, 0) + 1, ifnull(p, 0) * 1, iif(p IS NULL, 0, p) + 1, CASE WHEN p > 0 THEN p ELSE 0 END + 1 FROM t1;
}
expect {
    3.00|2.00|3.00|3.00
    1|0|1|1
}

@requires strict "uses STRICT tables"
test coalesce-with-text-literal-is-not-converted {
    CREATE TABLE t1(p numeric(10,2), d date) STRICT;
    INSERT INTO t1 VALUES (NULL, NULL);
    SELECT coalesce(p, 'none'), coalesce(d, 'none'), CASE WHEN p IS NULL THEN 'none' ELSE p END FROM t1;
}
expect {
    none|none|none
}

@requires strict "uses STRICT tables"
test typed-in-list-index-and-scan-agree {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric(5,2), s smallint, v varchar(3), u uuid) STRICT;
    CREATE INDEX t1_p ON t1(p);
    CREATE INDEX t1_s ON t1(s);
    CREATE INDEX t1_v ON t1(v);
    CREATE INDEX t1_u ON t1(u);
    INSERT INTO t1 VALUES (1, '1.55', 1, 'abc', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'), (2, '1.50', 2, 'abd', NULL);
    SELECT 'index', id FROM t1 WHERE p IN (1.5, 1.555, 100000);
    SELECT 'scan', id FROM t1 NOT INDEXED WHERE p IN (1.5, 1.555, 100000);
    SELECT 'index', id FROM t1 WHERE s IN (1, 100000);
    SELECT 'scan', id FROM t1 NOT INDEXED WHERE s IN (1, 100000);
    SELECT 'index', id FROM t1 WHERE v IN ('abc', 'abcdef');
    SELECT 'scan', id FROM t1 NOT INDEXED WHERE v IN ('abc', 'abcdef');
    SELECT 'index', id FROM t1 WHERE u IN ('A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11');
    SELECT 'scan', id FROM t1 NOT INDEXED WHERE u IN ('A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11');
}
expect {
    index|2
    scan|2
    index|1
    scan|1
    index|1
    scan|1
    index|1
    scan|1
}

@requires strict "uses STRICT tables"
test typed-join-uses-the-type-equality {
    CREATE TABLE t1(q numeric(10,0)) STRICT;
    CREATE TABLE t2(y numeric(10,1)) STRICT;
    CREATE TABLE t3(q numeric(10,3)) STRICT;
    INSERT INTO t1 VALUES ('10'), ('20');
    INSERT INTO t2 VALUES ('10.0'), ('30.0');
    INSERT INTO t3 VALUES ('10.000'), ('20.0');
    SELECT t1.q, t2.y FROM t1 JOIN t2 ON t1.q = t2.y;
    SELECT q FROM t1 JOIN t3 USING (q) ORDER BY 1;
    SELECT q FROM t1 NATURAL JOIN t3 ORDER BY 1;
}
expect {
    10|10.0
    10
    20
    10
    20
}

@requires strict "uses STRICT tables"
test long-operator-chain-is-typed-quickly {
    CREATE TABLE t1(a INTEGER, p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, '1.00');
    SELECT a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a + a FROM t1;
    SELECT p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p FROM t1;
}
expect {
    60
    60.00
}

@requires strict "uses STRICT tables"
test typed-expressions-sort-by-the-type-order {
    CREATE TABLE t1(p numeric(10,2), g INTEGER) STRICT;
    INSERT INTO t1 VALUES ('9.00', 1), ('10.00', 1);
    SELECT max(p * 1), min(p * 1) FROM t1;
    SELECT p FROM t1 ORDER BY p * 1 DESC;
    SELECT x FROM (SELECT p * 1 AS x FROM t1) ORDER BY x;
    SELECT p * 1 FROM t1 UNION ALL SELECT p * 2 FROM t1 ORDER BY 1;
    SELECT g, max(p * 1) FROM t1 GROUP BY g;
    SELECT max(x) FROM (SELECT p AS x FROM t1);
}
expect {
    10.00|9.00
    10.00
    9.00
    9.00
    10.00
    9.00
    10.00
    18.00
    20.00
    1|10.00
    10.00
}

@requires strict "uses STRICT tables"
test distinct-compares-numeric-values-by-key {
    CREATE TABLE t1(id INTEGER PRIMARY KEY, p numeric, q numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, '2', '2.00'), (2, '2.00', '2'), (3, '2.0', '3.00'), (4, NULL, NULL), (5, NULL, NULL);
    SELECT count(*) FROM (SELECT DISTINCT p FROM t1);
    SELECT count(DISTINCT p), count(p), count(DISTINCT q * 1) FROM t1;
    SELECT count(*) FROM (SELECT DISTINCT p * 1 FROM t1 WHERE p IS NOT NULL);
    SELECT DISTINCT p, q FROM t1 ORDER BY q, id;
    SELECT hex(numeric_key(1.5)) = hex(numeric_key('1.50')), numeric_key(-2) < numeric_key(0.5), numeric_key(NULL) IS NULL;
}
expect {
    2
    1|3|2
    1
    |
    2|2.00
    2|3.00
    1|1|1
}

@requires strict "uses STRICT tables"
test group-by-groups-numeric-values-by-key {
    CREATE TABLE t1(p numeric, x INTEGER) STRICT;
    INSERT INTO t1 VALUES ('10', 1), ('9', 2), ('2.00', 3), ('2', 4), (NULL, 5), (NULL, 6), ('2.0', 7);
    SELECT p = 2, count(*), sum(x) FROM t1 GROUP BY p ORDER BY sum(x);
    SELECT count(*) FROM t1 GROUP BY p * 1 HAVING count(*) > 1 ORDER BY 1;
}
expect {
    0|1|1
    0|1|2
    |2|11
    1|3|14
    2
    3
}

@requires strict "uses STRICT tables"
test in-subquery-uses-the-type-equality {
    CREATE TABLE t1(q numeric(10,0)) STRICT;
    CREATE INDEX t1_q ON t1(q);
    CREATE TABLE t2(y numeric(10,1)) STRICT;
    CREATE TABLE t4(x INTEGER) STRICT;
    INSERT INTO t1 VALUES ('10'), ('20'), (NULL);
    INSERT INTO t2 VALUES ('10.0'), ('30.0');
    INSERT INTO t4 VALUES (10), (NULL);
    SELECT q, q IN (SELECT y FROM t2), q NOT IN (SELECT y FROM t2), q IN (SELECT x FROM t4), q NOT IN (SELECT x FROM t4) FROM t1 ORDER BY q;
    SELECT q FROM t1 WHERE q IN (SELECT y FROM t2);
    SELECT q FROM t1 WHERE q NOT IN (SELECT y FROM t2);
    SELECT q FROM t1 WHERE q IN (SELECT y FROM t2 WHERE y > t1.q - 1);
}
expect {
    ||||
    10|1|0|1|0
    20|0|1||
    10
    20
    10
}

@requires strict "uses STRICT tables"
test hash-join-compares-typed-values-by-key {
    CREATE TABLE t1(q numeric(10,0)) STRICT;
    CREATE TABLE t2(y numeric(10,1)) STRICT;
    CREATE TABLE t4(x INTEGER) STRICT;
    INSERT INTO t1 VALUES ('10'), ('20');
    INSERT INTO t2 VALUES ('10.0'), ('30.0');
    INSERT INTO t4 VALUES (10), (30);
    EXPLAIN QUERY PLAN SELECT t1.q, t2.y FROM t1 JOIN t2 ON t1.q = t2.y;
    SELECT t1.q, t2.y FROM t1 JOIN t2 ON t1.q = t2.y;
    SELECT t1.q, t4.x FROM t1 JOIN t4 ON t1.q = t4.x;
    SELECT t2.y, t4.x FROM t2 JOIN t4 ON t4.x = t2.y ORDER BY 1;
}
expect {
    1|0|0|HASH JOIN t2
    2|0|0|SCAN t1
    10|10.0
    10|10
    10.0|10
    30.0|30
}

@requires strict "uses STRICT tables"
test union-intersect-and-except-compare-typed-values-by-key {
    CREATE TABLE t1(p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('2.00');
    CREATE TABLE t2(y numeric(10,1)) STRICT;
    INSERT INTO t2 VALUES ('2.0'), ('3.0'), (NULL);
    SELECT * FROM (SELECT p FROM t1 UNION SELECT 2);
    SELECT * FROM (SELECT p FROM t1 UNION SELECT y FROM t2) ORDER BY 1;
    SELECT count(*) FROM (SELECT p FROM t1 UNION SELECT y FROM t2 UNION SELECT 2 UNION SELECT NULL);
    SELECT * FROM (SELECT y FROM t2 INTERSECT SELECT p FROM t1);
    SELECT * FROM (SELECT y FROM t2 EXCEPT SELECT p FROM t1) ORDER BY 1;
    SELECT count(*) FROM (SELECT p FROM t1 UNION VALUES (2), (2.0), (5));
    SELECT count(*) FROM (SELECT p FROM t1 UNION ALL SELECT 2 UNION SELECT y FROM t2);
    SELECT count(*) FROM (SELECT p, 'a' FROM t1 UNION SELECT y, 'a' FROM t2);
}
expect {
    2.00
    
    2.00
    3.0
    3
    2.0
    
    3.0
    2
    3
    3
}

@requires strict "uses STRICT tables"
test unary-minus-and-abs-use-type-functions {
    CREATE TABLE t1(p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('1.50'), ('-2.25'), ('0.00'), (NULL);
    SELECT -p, abs(p), -(p * 1) + 1, abs(-p) < 2 FROM t1;
}
expect {
    -1.50|1.50|-0.50|1
    2.25|2.25|3.25|0
    0.00|0.00|1.00|1
    |||
}

test create-type-function-clause-is-called-for-typed-arguments {
    CREATE TYPE money(value any) BASE text ENCODE value DECODE value OPERATOR '-' (money) RETURNS money numeric_neg FUNCTION abs(money) RETURNS money numeric_abs FUNCTION length(money) RETURNS integer numeric_key;
    CREATE TABLE t1(m money) STRICT;
    INSERT INTO t1 VALUES ('-1.50');
    SELECT abs(m), -m, typeof(length(m)), abs(-3) FROM t1;
}
expect {
    1.50|1.50|blob|3
}

@requires strict "uses STRICT tables"
test cast-returns-the-value-read-back-from-a-strict-column {
    SELECT CAST('1.505' AS numeric(10,2)), typeof(CAST('1.505' AS numeric(10,2)));
    SELECT CAST('12' AS bigint), typeof(CAST('12' AS bigint)), CAST(1 AS varchar(10)), typeof(CAST(1 AS varchar(10)));
    SELECT CAST('12abc' AS INTEGER), CAST('1.5' AS NUMERIC), typeof(CAST('1.5' AS NUMERIC));
    SELECT CAST('2.50' AS numeric(10,2)) + 1, CAST(NULL AS numeric(10,2)) IS NULL;
}
expect {
    1.51|text
    12|integer|1|text
    12|1.5|real
    3.50|1
}

@requires strict "uses STRICT tables"
test cast-rejects-what-a-strict-column-rejects {
    SELECT CAST('12abc' AS bigint);
}
expect error {
    invalid input for type bigint
}

@requires strict "uses STRICT tables"
test check-constraint-sees-decoded-values {
    CREATE TYPE cents BASE integer ENCODE value * 100 DECODE value / 100;
    CREATE TABLE t1(amount cents CHECK (amount < CAST(50 AS cents)), code cents CHECK (length(code) <= 3)) STRICT;
    INSERT INTO t1 VALUES (42, 999);
    SELECT amount, code FROM t1;
}
expect {
    42|999
}

@requires strict "uses STRICT tables"
test recursive-cte-columns-have-the-anchor-type {
    CREATE TABLE t1(p numeric(10,2), q numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES ('1.00', '0.50');
    WITH RECURSIVE r(x) AS (SELECT CAST('1.00' AS numeric(10,2)) UNION ALL SELECT x + 1 FROM r WHERE x < 3) SELECT x FROM r;
    WITH RECURSIVE r(x) AS (SELECT p FROM t1 UNION ALL SELECT x + 0.505 FROM r WHERE x < 2) SELECT x FROM r;
    SELECT x + 1 FROM (SELECT p AS x FROM t1 UNION ALL SELECT q FROM t1) ORDER BY 1;
}
expect {
    1.00
    2.00
    3.00
    1.00
    1.51
    2.02
    1.50
    2.00
}

@requires strict "uses STRICT tables"
test window-partitions-and-peers-compare-typed-values-by-key {
    CREATE TABLE t1(p numeric, g INTEGER) STRICT;
    INSERT INTO t1 VALUES ('2', 1), ('2.00', 2), ('10', 3), ('9', 4);
    SELECT g, count(*) OVER (PARTITION BY p) FROM t1 ORDER BY g;
    SELECT g, rank() OVER (ORDER BY p) FROM t1 ORDER BY g;
    SELECT g, sum(g) OVER (ORDER BY p RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t1 ORDER BY g;
    SELECT g, count(*) OVER (ORDER BY p ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING EXCLUDE TIES) FROM t1 ORDER BY g;
}
expect {
    1|2
    2|2
    3|1
    4|1
    1|1
    2|1
    3|4
    4|3
    1|3
    2|3
    3|10
    4|7
    1|1
    2|2
    3|2
    4|3
}

@requires strict "uses STRICT tables"
test window-range-offset-on-typed-order-by-is-an-error {
    CREATE TABLE t1(p numeric, g INTEGER) STRICT;
    SELECT g, sum(g) OVER (ORDER BY p RANGE BETWEEN 1 PRECEDING AND CURRENT ROW) FROM t1;
}
expect error {
    RANGE frames with an offset are not supported
}

@requires strict "uses STRICT tables"
@requires materialized_views "uses materialized views"
test materialized-view-computes-typed-expressions {
    CREATE TABLE t1(p numeric(10,2), g INTEGER) STRICT;
    INSERT INTO t1 VALUES ('1.25', 1), ('2.25', 1);
    CREATE MATERIALIZED VIEW v AS SELECT g, p * 2 AS x FROM t1;
    INSERT INTO t1 VALUES ('0.25', 2);
    SELECT g, x FROM v ORDER BY g, x;
}
expect {
    1|2.50
    1|4.50
    2|0.50
}

@requires strict "uses STRICT tables"
@requires materialized_views "uses materialized views"
test materialized-view-rejects-aggregates-over-typed-values {
    CREATE TABLE t1(p numeric(10,2), g INTEGER) STRICT;
    CREATE MATERIALIZED VIEW w AS SELECT g, sum(p) AS s FROM t1 GROUP BY g;
}
expect error {
    aggregates over values of type numeric are not yet supported
}

@requires strict "uses STRICT tables"
@requires materialized_views "uses materialized views"
test materialized-view-rejects-grouping-by-keyed-values {
    CREATE TABLE t1(p numeric, g INTEGER) STRICT;
    CREATE MATERIALIZED VIEW w AS SELECT p, count(*) AS c FROM t1 GROUP BY p;
}
expect error {
    GROUP BY on values compared by a type key are not yet supported
}

@requires strict "uses STRICT tables"
test cast-inside-encode-keeps-the-encoded-value {
    CREATE TYPE pos(value any) BASE text ENCODE CASE WHEN CAST(value AS numeric(10,2)) < CAST(0 AS numeric(10,2)) THEN RAISE(ABORT, 'negative') ELSE value END DECODE value;
    CREATE TABLE t1(x pos) STRICT;
    INSERT INTO t1 VALUES ('5');
    SELECT x FROM t1;
}
expect {
    5
}

@requires strict "uses STRICT tables"
test nested-functions-are-typed-quickly {
    CREATE TABLE t1(a INTEGER, p numeric(10,2)) STRICT;
    INSERT INTO t1 VALUES (1, '1.50');
