# Owned specs for SELECT statements and expressions lowered by the MySQL
# frontend (mysql/parser/query.rs, expr.rs, literal.rs): MySQL-only operators,
# literals and escapes, and the clauses of a SELECT. Every expected value was
# recorded from MySQL 8.4.10 (mysql/conformance/target.toml) with
# `mysql --batch --raw`; error tests note the MySQL error in a comment.

@database :memory:

setup nums {
    CREATE TABLE nums(id INTEGER PRIMARY KEY, name VARCHAR(20), grp INTEGER);
    INSERT INTO nums VALUES (1, 'one', 1), (2, 'two', 1), (3, 'three', 2), (4, 'four', 2), (5, 'five', NULL);
}

setup pairs {
    CREATE TABLE lefts(id INTEGER PRIMARY KEY, k INTEGER);
    CREATE TABLE rights(id INTEGER PRIMARY KEY, k INTEGER);
    INSERT INTO lefts VALUES (1, 10), (2, 20), (3, 30);
    INSERT INTO rights VALUES (1, 10), (2, 25), (4, 40);
}

test div-truncates-toward-zero {
    SELECT 7 DIV 2, -7 DIV 2, 7 DIV -2, 7 DIV 0, NULL DIV 2;
}
expect {
    3|-3|-3|NULL|NULL
}

test div-binds-like-multiplication {
    SELECT 7 DIV 2 + 1, 1 + 7 DIV 2, 2 * 7 DIV 2, 7 DIV 2 * 2, 20 DIV 2 DIV 3;
}
expect {
    4|4|7|6|3
}

test div-of-non-integers {
    SELECT 7.5 DIV 2, '7' DIV 2, 1e1 DIV 3, -7.5 DIV 2;
}
expect {
    3|3|3|-3
}

test mod-operator {
    SELECT 7 MOD 3, -7 MOD 3, 7 % 3, MOD(7, 3), 7 MOD 0, 2 + 7 MOD 3;
}
expect {
    1|-1|1|1|NULL|3
}

test xor-is-logical-and-binds-below-and {
    SELECT 1 XOR 1, 1 XOR 0, 0 XOR 0, 1 XOR NULL, 1 XOR 1 = 0, 1 XOR 1 AND 0, 5 XOR 0;
}
expect {
    0|1|0|NULL|1|1|1
}

test double-ampersand-and-double-pipe-are-logical {
    SELECT 1 && 0, 1 || 0, 0 || NULL, 1 && NULL, 1 = 1 || 0 = 1, 0 || 0 && 1;
}
expect {
    0|1|NULL|NULL|1|0
}

test exclamation-mark-binds-tighter-than-not {
    SELECT !0, !1, !NULL, !1 + 1, NOT 1 + 1, ! 2 = 0;
}
expect {
    1|0|NULL|1|0|1
}

test caret-is-bitwise-xor-above-multiplication {
    SELECT 5 ^ 3, 2 * 3 ^ 1, 6 ^ 0, 1 ^ 1 ^ 1;
}
expect {
    6|4|6|1
}

test null-safe-equality {
    SELECT NULL <=> NULL, 1 <=> NULL, NULL <=> 1, 1 <=> 1, 1 <=> 2;
}
expect {
    1|0|0|1|0
}

test bitwise-operator-precedence {
    SELECT 1 & 3 << 1, 1 | 2 & 3, 1 + 1 << 1, 6 >> 1 & 1;
}
expect {
    0|3|4|1
}

test unary-minus-binds-tighter-than-caret {
    SELECT -1 + 2, - 2 * 3, -(1 + 2);
}
expect {
    1|-6|-3
}

@setup nums
test double-quoted-string-is-not-a-column {
    SELECT id FROM nums WHERE name = "name";
}
expect {
}

@setup nums
test double-quoted-string-compares-as-text {
    SELECT id FROM nums WHERE name = "two";
}
expect {
    2
}

test double-quoted-string-alias {
    SELECT "foo" AS "dummy", 'bar' AS 'single';
}
expect {
    foo|bar
}

test backslash-escapes {
    SELECT 'a\\fb', 'a\\ab', HEX('\\0'), HEX('\\t'), HEX('\\n\\r\\b'), 'x\\%y', 'x\\_y', HEX('\\Z'), 'it\\'s', "say \\"hi\\"", 'back\\\\slash';
}
expect {
    afb|aab|00|09|0A0D08|x\\%y|x\\_y|1A|it's|say "hi"|back\\slash
}

test doubled-quotes-in-strings {
    SELECT 'it''s', "say ""hi""", 'mixed "q"', "mixed 'q'";
}
expect {
    it's|say "hi"|mixed "q"|mixed 'q'
}

test hexadecimal-and-bit-literals-are-binary-strings {
    SELECT 0x41, X'4142', x'', b'1000001', 0b1000010, B'', HEX(0x41);
}
expect {
    A|AB||A|B||41
}

test hexadecimal-literals-compare-as-numbers-or-strings {
    SELECT 0x41 = 65, 0x41 = 'A', 65 = 0x41, 'A' = X'41', 0x41 IN (65, 66), 0x41 < 66;
}
expect {
    1|1|1|1|1|1
}

test hexadecimal-literals-in-bitwise-and-logical-operators {
    SELECT X'40' | X'01', b'11110001' & b'01001111', 0x01 AND 1, NOT 0x00, 0x0F >> 1;
}
expect {
    65|65|1|1|7
}

test charset-introducers {
    SELECT _utf8mb4'abc', _utf8mb4"dq", _binary'abc', _utf8mb4 0x41, HEX(_binary'A'), _latin1'x', _utf8'u', _utf8mb3'u3';
}
expect {
    abc|dq|abc|A|41|x|u|u3
}

test charset-introducer-compares-as-text {
    SELECT _utf8mb4'abc' = 'abc', _binary'abc' = 'abc', _utf8mb4'abc' LIKE 'a%';
}
expect {
    1|1|1
}

test national-string {
    SELECT N'national';
}
expect {
    national
}

test typed-temporal-literals {
    SELECT DATE '2018-5-1', TIME '1:2:3', TIMESTAMP '2020-1-2 3:4:5', TIME '10', DATE '20180501', TIME '-1:00:00', TIME '1 02:00:00';
}
expect {
    2018-05-01|01:02:03|2020-01-02 03:04:05|00:00:10|2018-05-01|-01:00:00|26:00:00
}

test typed-temporal-literals-keep-fractions {
    SELECT TIMESTAMP '2020-01-02 03:04:05.5', TIME '10:00:00.123', TIMESTAMP '2020-01-02T03:04:05';
}
expect {
    2020-01-02 03:04:05.5|10:00:00.123|2020-01-02 03:04:05
}

test typed-temporal-literal-compares-as-text {
    SELECT DATE '2018-05-01' = '2018-05-01', DATE '2018-05-01' < '2019-01-01', TIME '10:00:00' = '10:00:00';
}
expect {
    1|1|1
}

test odbc-date-literal {
    SELECT {d '2018-05-01'};
}
expect {
    2018-05-01
}

# MySQL: ERROR 1525 (HY000): Incorrect DATE value: '2018-02-30'
test invalid-date-literal-fails {
    SELECT DATE '2018-02-30';
}
expect error {
}

test like-uses-backslash-as-default-escape {
    SELECT 'a%' LIKE 'a\\%', 'ab' LIKE 'a\\%', 'a_b' LIKE 'a\\_b', 'axb' LIKE 'a\\_b', 'a\\\\b' LIKE 'a\\\\\\\\b';
}
expect {
    1|0|1|0|1
}

test like-with-explicit-escape {
    SELECT 'a%' LIKE 'a|%' ESCAPE '|', 'ab' LIKE 'a|%' ESCAPE '|', 'ab' NOT LIKE 'a%';
}
expect {
    1|0|0
}

test regexp-operator {
    SELECT 'abc' REGEXP '^a', 'abc' RLIKE 'z', 'abc' NOT REGEXP 'b';
}
expect {
    1|0|0
}

test is-true-false-unknown {
    SELECT 1 IS TRUE, 0 IS TRUE, NULL IS TRUE, 0 IS FALSE, NULL IS NOT FALSE, NULL IS UNKNOWN, 1 IS NOT UNKNOWN;
}
expect {
    1|0|0|1|1|1|1
}

test case-expressions {
    SELECT CASE WHEN 1 > 2 THEN 'a' WHEN 2 > 1 THEN 'b' END, CASE 3 WHEN 1 THEN 'x' WHEN 3 THEN 'y' ELSE 'z' END, CASE NULL WHEN NULL THEN 1 ELSE 0 END;
}
expect {
    b|y|0
}

test between-and-in {
    SELECT 5 BETWEEN 1 AND 10, 5 NOT BETWEEN 1 AND 4, 2 IN (1, 2), 3 NOT IN (1, 2), NULL IN (1, 2), 1 BETWEEN 0 AND 2 = 1;
}
expect {
    1|1|1|1|NULL|1
}

test cast-and-convert {
    SELECT CAST('12' AS SIGNED), CAST(-5 AS SIGNED INTEGER), CAST(5 AS CHAR), CONVERT('abc' USING utf8mb4), CONVERT(7, CHAR), CAST(1.5e0 AS DOUBLE), CONVERT('x' USING binary);
}
expect {
    12|-5|5|abc|7|1.5|x
}

test string-functions-with-special-syntax {
    SELECT TRIM(LEADING 'x' FROM 'xxaxx'), TRIM(TRAILING 'x' FROM 'xxaxx'), TRIM(BOTH 'x' FROM 'xxaxx'), TRIM('  a  '), SUBSTRING('abcdef' FROM 2 FOR 3), SUBSTRING('abcdef', 3), SUBSTR('abcdef' FROM 4);
}
expect {
    axx|xxa|a|a|bcd|cdef|def
}

test select-from-dual {
    SELECT 1 + 1 FROM DUAL;
}
expect {
    2
}

@setup nums
test select-star-and-qualified-star {
    SELECT * FROM nums WHERE id = 1;
    SELECT n.* FROM nums AS n WHERE n.id = 2;
}
expect {
    1|one|1
    2|two|1
}

@setup nums
test where-group-by-having-order-by {
    SELECT grp, COUNT(*), SUM(id) FROM nums WHERE id > 1 GROUP BY grp HAVING COUNT(*) > 1 ORDER BY grp DESC;
}
expect {
    2|2|7
}

@setup nums
test div-in-group-by-ordinal {
    SELECT id DIV 2, COUNT(*) FROM nums GROUP BY 1 ORDER BY 1;
}
expect {
    0|1
    1|2
    2|2
}

@setup nums
test order-by-alias-and-ordinal {
    SELECT id * -1 AS neg, name FROM nums ORDER BY neg LIMIT 2;
    SELECT name, id FROM nums ORDER BY 2 DESC LIMIT 1;
}
expect {
    -5|five
    -4|four
    five|5
}

@setup nums
test limit-offset-forms {
    SELECT id FROM nums ORDER BY id LIMIT 2, 2;
    SELECT id FROM nums ORDER BY id LIMIT 1 OFFSET 3;
    SELECT id FROM nums ORDER BY id LIMIT 0;
}
expect {
    3
    4
    4
}

@setup nums
test distinct-and-all {
    SELECT DISTINCT grp FROM nums ORDER BY grp;
    SELECT ALL grp FROM nums WHERE grp = 1;
}
expect {
    NULL
    1
    2
    1
    1
}

@setup pairs
test inner-and-left-joins {
    SELECT l.id, r.id FROM lefts AS l JOIN rights AS r ON l.k = r.k ORDER BY l.id;
    SELECT l.id, r.id FROM lefts l LEFT JOIN rights r ON l.k = r.k ORDER BY l.id;
    SELECT l.id, r.id FROM lefts l LEFT OUTER JOIN rights r ON l.k = r.k WHERE r.id IS NULL ORDER BY l.id;
}
expect {
    1|1
    1|1
    2|NULL
    3|NULL
    2|NULL
    3|NULL
}

@setup pairs
test right-cross-and-comma-joins {
    SELECT l.id, r.id FROM lefts l RIGHT JOIN rights r ON l.k = r.k ORDER BY r.id;
    SELECT COUNT(*) FROM lefts CROSS JOIN rights;
    SELECT COUNT(*) FROM lefts, rights WHERE lefts.id = rights.id;
}
expect {
    1|1
    NULL|2
    NULL|4
    9
    2
}

@setup pairs
test using-and-natural-joins {
    SELECT id, lefts.k, rights.k FROM lefts JOIN rights USING (id) ORDER BY id;
    SELECT id, k FROM lefts NATURAL JOIN rights;
}
expect {
    1|10|10
    2|20|25
    1|10
}

@setup pairs
test derived-tables-and-subqueries {
    SELECT t.total FROM (SELECT SUM(k) AS total FROM lefts) AS t;
    SELECT id FROM lefts WHERE k IN (SELECT k FROM rights) ORDER BY id;
    SELECT id FROM lefts WHERE EXISTS (SELECT 1 FROM rights WHERE rights.id = lefts.id) ORDER BY id;
    SELECT id, (SELECT MAX(k) FROM rights) FROM lefts WHERE id = 1;
    SELECT id FROM lefts WHERE k = ANY (SELECT k FROM rights) ORDER BY id;
    SELECT id FROM lefts WHERE k <> ALL (SELECT k FROM rights) ORDER BY id;
}
expect {
    60
    1
    1
    2
    1|40
    1
    2
    3
}

test union-intersect-except {
    SELECT 1 UNION SELECT 1 UNION ALL SELECT 2;
    SELECT 1 UNION ALL SELECT 2 INTERSECT SELECT 3;
    SELECT 1 UNION DISTINCT SELECT 2 EXCEPT SELECT 2;
}
expect {
    1
    2
    1
    1
}

@setup nums
test parenthesized-union-members {
    (SELECT id FROM nums ORDER BY id DESC LIMIT 1) UNION ALL (SELECT id FROM nums ORDER BY id LIMIT 1);
    SELECT id FROM nums WHERE id < 3 UNION SELECT id FROM nums WHERE id > 3 ORDER BY id DESC LIMIT 2;
}
expect {
    5
    1
    5
    4
}

test common-table-expressions {
    WITH t AS (SELECT 1 AS a) SELECT a FROM t;
    WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 4) SELECT SUM(n), COUNT(*) FROM c;
}
expect {
    1
    10|4
}

@setup nums
test window-functions {
    SELECT id, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id DESC) FROM nums WHERE grp IS NOT NULL ORDER BY id;
    SELECT id, SUM(id) OVER w FROM nums WHERE id < 4 WINDOW w AS (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) ORDER BY id;
}
expect {
    1|2
    2|1
    3|2
    4|1
    1|1
    2|3
    3|5
}

@setup nums
test group-concat-separator-and-multiple-arguments {
    SELECT GROUP_CONCAT(id SEPARATOR '-') FROM nums;
    SELECT GROUP_CONCAT(name, id) FROM nums WHERE id < 3;
    SELECT GROUP_CONCAT(name, NULL) FROM nums;
    SELECT grp, GROUP_CONCAT(id SEPARATOR '') FROM nums WHERE grp IS NOT NULL GROUP BY grp ORDER BY grp;
}
expect {
    1-2-3-4-5
    one1,two2
    NULL
    1|12
    2|34
}

test values-statement {
    VALUES ROW(1, 'a'), ROW(2, 'b');
}
expect {
    1|a
    2|b
}

@setup nums
test aggregate-without-group-by {
    SELECT COUNT(*), MIN(id), MAX(name), SUM(grp) FROM nums;
}
expect {
    5|1|two|6
}

@setup nums
test escaped-quote-keeps-the-statement-whole {
    SELECT id FROM nums WHERE name = 'a\\'; DROP TABLE nums; -- ';
    SELECT COUNT(*) FROM nums;
}
expect {
    5
}

test json-boolean-values-and-casts {
    SELECT JSON_ARRAY(TRUE, 1 = 1, NOT 0, 1 IN (2)), JSON_OBJECT('a', 1 < 2), CAST(1 = 1 AS JSON), CAST('[1, 2]' AS JSON), 2 MEMBER OF ('[1, 2]');
}
expect {
    [true, true, true, false]|{"a": true}|true|[1, 2]|1
}

test json-arrow-operators {
    SELECT j->'$.a', j->>'$.a', j->'$.b[1]' FROM (SELECT '{"a": "x", "b": [1, 2]}' AS j) AS t;
}
expect {
    "x"|x|2
}
