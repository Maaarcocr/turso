    SELECT MAKEDATE(time'00:00:59.2132234', 0x1);
}
expect {
    2059-01-01
}

test t-16560 {
    SELECT MAKEDATE(time'00:00:59.2132234', b'1001');
}
expect {
    2059-01-09
}

test t-16567 {
    SELECT MAKEDATE(time'00:00:59.2132234', 1 * NULL);
}
expect {
    NULL
}
