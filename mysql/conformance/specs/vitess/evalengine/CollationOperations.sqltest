@database :memory:

test t-0 {
    SELECT COLLATION('foobar');
}
expect {
    utf8mb4_0900_ai_ci
}

test t-1 {
    SELECT COLLATION(_latin1 'foobar');
}
expect {
    latin1_swedish_ci
}

test t-2 {
    SELECT COLLATION(_utf8mb4 'foobar' COLLATE utf8mb4_general_ci);
}
expect {
    utf8mb4_general_ci
}

test t-3 {
    SELECT COLLATION('foobar' COLLATE utf8mb4_general_ci);
}
expect {
    utf8mb4_general_ci
}

# mysql-error: 1253 42000 COLLATION 'utf8mb4_general_ci' is not valid for CHARACTER SET 'latin1'
