test t-0 {
    SELECT REGEXP_REPLACE('a b c', 'b', 'X');
}
expect {
    a X c
}

test t-1 {
    SELECT REGEXP_REPLACE('abc def ghi', '[a-z]+', 'X', 1, 0);
}
expect {
    X X X
}

