}

test t-12842 {
    SELECT CONCAT(20000101103458, -1.7);
}
expect {
    20000101103458-1.7
}

test t-12878 {
    SELECT CONCAT(20000101103458, -9223372036854775808);
}
expect {
    20000101103458-9223372036854775808
}

test t-12893 {
    SELECT CONCAT(20000101103458, time '5 10:34:58.9');
}
expect {
    20000101103458130:34:58.9
}

test t-12908 {
    SELECT CONCAT(20000101103458, '20000101');
}
expect {
    2000010110345820000101
}

test t-12916 {
    SELECT CONCAT(20000101103458, '103458.123456foo');
}
expect {
    20000101103458103458.123456foo
}

test t-12933 {
    SELECT CONCAT(20000101103458, '1970-01-01 00:00:01');
}
expect {
    200001011034581970-01-01 00:00:01
}

test t-12946 {
    SELECT CONCAT(20000101103458, cast(2 as json));
}
expect {
    200001011034582
}

test t-12947 {
    SELECT CONCAT(20000101103458, cast(1.1 as json));
}
expect {
    200001011034581.1
}

test t-12948 {
    SELECT CONCAT(20000101103458, cast(-1.1 as json));
}
expect {
    20000101103458-1.1
}

test t-12960 {
    SELECT CONCAT(20000101103458, cast(_binary' "foo"' as json));
}
expect {
    20000101103458"base64:type15:ICJmb28i"
}

test t-12967 {
    SELECT CONCAT(20000101103458, cast('["ab"]' as json));
}
expect {
    20000101103458["ab"]
}
