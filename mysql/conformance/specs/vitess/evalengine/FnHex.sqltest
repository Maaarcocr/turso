}
expect {
    666F6F62617231323334
}

test t-218 {
    SELECT hex("0");
}
expect {
    30
}

test t-220 {
    SELECT hex(-0x1);
}
expect {
    FFFFFFFFFFFFFFFF
}

test t-223 {
    SELECT hex("1abcd");
}
expect {
    3161626364
}

test t-225 {
    SELECT hex(_binary "foobar");
}
expect {
    666F6F626172
}

test t-226 {
    SELECT hex(_binary "foobar1234");
}
expect {
    666F6F62617231323334
}

test t-227 {
    SELECT hex(64);
}
expect {
    40
}

test t-228 {
    SELECT hex('64');
}
expect {
    3634
}

test t-229 {
    SELECT hex(_binary '64');
}
expect {
    3634
}

test t-230 {
    SELECT hex(X'40');
}
expect {
    40
}

test t-231 {
    SELECT hex(_binary X'40');
}
expect {
    40
}
