}

test t-200 {
    SELECT JSON_ARRAY(JSON_OBJECT(), 1);
}
expect {
    [\{\}, 1]
}

test t-201 {
    SELECT JSON_ARRAY(JSON_OBJECT(), 1.0);
}
expect {
    [\{\}, 1.0]
}

test t-202 {
    SELECT JSON_ARRAY(JSON_OBJECT(), '1');
}
expect {
    [\{\}, "1"]
}

test t-203 {
    SELECT JSON_ARRAY(JSON_OBJECT(), '1.0');
}
expect {
    [\{\}, "1.0"]
}

test t-204 {
    SELECT JSON_ARRAY(JSON_OBJECT(), NULL);
}
expect {
    [\{\}, null]
}

test t-205 {
    SELECT JSON_ARRAY(JSON_OBJECT(), 'NULL');
}
expect {
    [\{\}, "NULL"]
}

test t-206 {
    SELECT JSON_ARRAY(JSON_OBJECT(), 'foobar');
}
expect {
    [\{\}, "foobar"]
}

test t-207 {
    SELECT JSON_ARRAY(JSON_OBJECT(), 'foo\nbar');
}
expect {
    [\{\}, "foo\nbar"]
}

test t-208 {
    SELECT JSON_ARRAY(JSON_OBJECT(), 'a');
}
expect {
    [\{\}, "a"]
}

test t-209 {
    SELECT JSON_ARRAY(JSON_OBJECT(), JSON_OBJECT());
}
expect {
    [\{\}, \{\}]
}

test t-210 {
    SELECT JSON_ARRAY(CAST('foo' AS BINARY));
}
expect {
    ["base64:type15:Zm9v"]
}

test t-211 {
    SELECT JSON_ARRAY('a', CAST('foo' AS BINARY));
}
expect {
    ["a", "base64:type15:Zm9v"]
}

test t-212 {
    SELECT JSON_ARRAY(b'1010');
}
expect {
    ["base64:type15:Cg=="]
}

test t-213 {
    SELECT JSON_ARRAY('a', b'1010');
}
expect {
    ["a", "base64:type15:Cg=="]
}

test t-214 {
    SELECT JSON_ARRAY();
}
expect {
    []
}
