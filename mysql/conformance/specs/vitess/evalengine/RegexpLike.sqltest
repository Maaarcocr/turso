    SELECT REGEXP_LIKE(0x1, '', NULL);
}
expect error {
}

# mysql-error: 3995 HY000 Character set 'binary' cannot be used in conjunction with 'utf8mb4_0900_ai_ci' in call to regexp_like.
test t-2896 {
    SELECT REGEXP_LIKE(0x1, '', 'i');
}
expect error {
}

test t-2903 {
    SELECT 0x1 NOT REGEXP _binary 'foobar';
}
expect {
    1
}

test t-2904 {
    SELECT REGEXP_LIKE(0x1, _binary 'foobar', NULL);
}
expect {
    NULL
}

test t-2906 {
    SELECT REGEXP_LIKE(0x1, _binary 'foobar', 'i');
}
expect {
    0
}

test t-2909 {
    SELECT REGEXP_LIKE(0x1, _binary 'foobar', 'u');
}
expect {
    0
}

test t-2910 {
    SELECT REGEXP_LIKE(0x1, _binary 'foobar', 'cimnu');
}
expect {
    0
}

test t-2913 {
    SELECT 0x1 NOT REGEXP 0x0;
}
expect {
    1
}

test t-2916 {
    SELECT REGEXP_LIKE(0x1, 0x0, 'i');
}
expect {
    0
}

test t-2923 {
    SELECT 0x1 NOT REGEXP 0x1;
}
expect {
    0
}

test t-2935 {
    SELECT REGEXP_LIKE(0x1, 0xff, 'c');
}
expect {
    0
}

test t-2940 {
    SELECT REGEXP_LIKE(0x1, 0xff, 'cimnu');
}
expect {
    0
}

test t-2941 {
    SELECT REGEXP_LIKE(0x1, 0xff, 'cimnuunmic');
}
expect {
    0
}

test t-2948 {
    SELECT REGEXP_LIKE(0x1, NULL, 'n');
}
expect {
    NULL
}

test t-2955 {
    SELECT REGEXP_LIKE(0x1, true, 'c');
}
expect {
    0
}

test t-2956 {
    SELECT REGEXP_LIKE(0x1, true, 'i');
}
expect {
    0
}

test t-2957 {
    SELECT REGEXP_LIKE(0x1, true, 'm');
}
expect {
    0
}

test t-2959 {
    SELECT REGEXP_LIKE(0x1, true, 'u');
}
expect {
    0
}

test t-2962 {
    SELECT 0x1 REGEXP false;
}
expect {
    0
}

test t-2963 {
    SELECT 0x1 NOT REGEXP false;
}
expect {
    1
}

test t-2964 {
    SELECT REGEXP_LIKE(0x1, false, NULL);
}
expect {
    NULL
}
