@database :memory:

setup s1 {
    create table t1
(
    id1 bigint,
    id2 bigint,
    primary key (id1)
) Engine=InnoDB;
}

setup s2 {
    insert into t1(id1, id2) values (0,0), (1,10), (2,20), (3,30), (4,40);
}

@setup s1
test l326 {
    insert into t1(id1, id2) values (0,0), (1,10), (2,20), (3,30), (4,40);
}
expect unordered {
}

@setup s1
@setup s2
test l328 {
    select A.id1, B.id2 from t1 as A left join t1 as B on A.id1*10 = B.id2 WHERE B.id2 BETWEEN 20 AND 30;
}
expect unordered {
    2|20
    3|30
}

@setup s1
@setup s2
test l330 {
    select A.id1, B.id2 from t1 as A left join t1 as B on A.id1*10 = B.id2 WHERE B.id2 NOT BETWEEN 20 AND 30;
}
expect unordered {
    0|0
    1|10
    4|40
}
