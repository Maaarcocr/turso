@database :memory:

setup s1 {
    create table t3
(
    id5 bigint,
    id6 bigint,
    id7 bigint,
    primary key (id5)
) Engine = InnoDB;
}

setup s2 {
    insert into t3(id5, id6, id7) values(1,1,2), (2,2,4), (3,2,4), (4,1,2), (5,1,2), (6,3,6);
}

@setup s1
test l123 {
    insert into t3(id5, id6, id7) values(1,1,2), (2,2,4), (3,2,4), (4,1,2), (5,1,2), (6,3,6);
}
expect unordered {
}

@setup s1
@setup s2
test l130 {
    select id6, id7, count(*) k from t3 group by id6, id7 order by k;
}
expect {
    3|6|1
    2|4|2
    1|2|3
}

@setup s1
@setup s2
test l131 {
    select id6+id7, count(*) k from t3 group by id6+id7 order by k;
}
expect {
    9|1
    6|2
    3|3
}

@setup s1
@setup s2
test l132 {
    select id6, id7, count(*) k from t3 group by id6, id7 with rollup;
}
expect unordered {
    1|2|3
    1|NULL|3
    2|4|2
    2|NULL|2
    3|6|1
    3|NULL|1
    NULL|NULL|6
}
