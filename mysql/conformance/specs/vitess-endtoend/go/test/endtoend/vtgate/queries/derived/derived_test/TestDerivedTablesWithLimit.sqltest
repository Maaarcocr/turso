@database :memory:

setup s1 {
    create table user
(
    id   bigint,
    name varchar(255),
    primary key (id)
) Engine = InnoDB;
}

setup s2 {
    create table music
(
    id      bigint,
    user_id bigint,
    primary key (id)
) Engine = InnoDB;
    insert into user(id, name) values(6,'pikachu');
}

@setup s1
test l100 {
    insert into user(id, name) values(6,'pikachu');
}
expect unordered {
}

@setup s1
@setup s2
test l102 {
    SELECT u.id, m.id FROM
	            (SELECT id, name FROM user LIMIT 10) AS u JOIN
	            (SELECT id, user_id FROM music LIMIT 10) as m on u.id = m.user_id;
}
expect unordered {
}

@setup s1
@setup s2
test l108 {
    SELECT u.id, m.id FROM user AS u LEFT JOIN 
                (SELECT id, user_id FROM music LIMIT 10) as m on u.id = m.user_id;
}
expect unordered {
    6|NULL
}
