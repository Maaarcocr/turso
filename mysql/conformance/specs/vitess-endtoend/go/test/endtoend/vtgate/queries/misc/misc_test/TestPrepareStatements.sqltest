@database :memory:

setup s1 {
    create table t1
(
    id1 bigint,
    id2 bigint,
    primary key (id1)
) Engine=InnoDB;
}

setup s2 {
    insert into t1(id1, id2) values (0,0), (1,0), (2,0);
    prepare prep_pk from 'select count(*) from t1 where id1 = ?';
}

setup s3 {
    set @id1 = 1;
}

setup s4 {
    prepare prep_non_pk from 'select id1, id2 from t1 where id2 = ?';
}

setup s5 {
    prepare prep_non_pk from 'select id1, id2 from t1 where id2 = ?';
}

setup s6 {
    set @id2 = 0;
}

setup s7 {
    prepare prep_in_pk from 'select id1, id2 from t1 where id1 in (?, ?)';
}

setup s8 {
    set @id2 = 0;
    prepare prep_in_pk from 'select id1, id2 from t1 where id1 in (?, ?)';
}

setup s9 {
    prepare prep_in_pk from 'select id1, id2 from t1 where id1 in (?, ?)';
}

setup s10 {
    set @id1 = 1;
}

setup s11 {
    prepare prep_art from 'select 1+?, 10/?';
    deallocate prepare prep_art;
}

@setup s1
test l511 {
    insert into t1(id1, id2) values (0,0), (1,0), (2,0);
}
expect unordered {
}

