@setup s1
@setup s3
test l470 {
    SELECT t1.shardKey, t1.name, count(t2.id) FROM t1 JOIN t2 ON t1.value != t2.shardKey GROUP BY t1.t1_id;
}
expect unordered {
    1|name 1|2
    2|name 2|2
}

@setup s4
test l473 {
    select tbl0.comm, count(*) from emp as tbl0, emp as tbl1 where tbl0.empno = tbl1.deptno;
