@database :memory:

setup s1 {
    create table t4
(
    id1 bigint,
    id2 varchar(10),
    primary key (id1)
) ENGINE = InnoDB
  DEFAULT charset = utf8mb4
  COLLATE = utf8mb4_general_ci;
}

setup s2 {
    insert into t4(id1, id2) values(1,'a'), (2,'Abc'), (3,'b'), (4,'c'), (5,'test');
}

setup s3 {
    insert into t4(id1, id2) values(6,'d'), (7,'e'), (8,'F');
}

setup s4 {
    delete from t4;
}

