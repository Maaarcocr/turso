@database :memory:

setup s1 {
    create table user
(
    id   bigint,
    name varchar(255),
    primary key (id)
) Engine = InnoDB;
}

@setup s1
test l67 {
    WITH toto AS (SELECT COUNT(*) as num
                FROM (SELECT user.id
                      FROM user
                      WHERE user.name = 'toto'
						LIMIT 1000) t LIMIT 1 ),
    tata AS (SELECT COUNT(*) as num
                FROM (SELECT user.id
                        FROM user
                        WHERE user.name = 'tata'
						LIMIT 1000) t LIMIT 1),
    total AS (SELECT LEAST(1000, SUM(num)) AS num
                FROM (SELECT num
                        FROM toto
                        UNION ALL SELECT num
                                    FROM tata) t LIMIT 1)
SELECT 'total' AS tab, num
FROM total;
}
expect unordered {
    total|0
}
