@database :memory:

setup s1 {
    create table t1(
                   id1 bigint,
                   id2 bigint,
                   primary key(id1)
) Engine=InnoDB;
}

setup s2 {
    create table t2(
                   id3 bigint,
                   id4 bigint,
                   primary key(id3)
) Engine=InnoDB;
}

setup s3 {
    insert into t1(id1, id2) values (1, 1), (2, 2), (3,3), (4,4);
}

setup s4 {
    create table t2(
                   id3 bigint,
                   id4 bigint,
                   primary key(id3)
) Engine=InnoDB;
    insert into t1(id1, id2) values (1, 1), (2, 2), (3,3), (4,4);
    insert into t2(id3, id4) values (2, 3), (3, 4), (4,4), (5,5);
}

@setup s1
test l53 {
    insert into t1(id1, id2) values (1, 1), (2, 2), (3,3), (4,4);
}
