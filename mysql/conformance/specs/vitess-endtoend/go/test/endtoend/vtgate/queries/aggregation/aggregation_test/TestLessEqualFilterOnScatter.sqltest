@database :memory:

setup s1 {
    create table aggr_test
(
    id   bigint,
    val1 varchar(16),
    val2 bigint,
    primary key (id)
) Engine = InnoDB;
    insert into aggr_test(id, val1, val2) values(1,'a',1), (2,'b',2), (3,'c',3), (4,'d',4), (5,'e',5);
}

@setup s1
test l309 {
    select count(*) as a from aggr_test having a <= 10;
}
expect unordered {
    5
}

