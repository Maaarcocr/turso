@database :memory:

setup s1 {
    create table t1
(
    id1 bigint,
    id2 bigint,
    primary key (id1)
) Engine = InnoDB;
    insert into t1(id1, id2) values (0,10),(1,9),(2,8),(3,7),(4,6),(5,5);
}

@setup s1
test l62 {
    SELECT t1.id1, t1.id2 FROM t1 ORDER BY t1.id2 ASC, t1.id1 desc;
}
expect {
    5|5
    4|6
    3|7
    2|8
    1|9
    0|10
}
