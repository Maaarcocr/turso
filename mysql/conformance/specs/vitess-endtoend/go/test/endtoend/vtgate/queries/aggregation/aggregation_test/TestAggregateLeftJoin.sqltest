@database :memory:

setup s1 {
    CREATE TABLE t1 (
    t1_id bigint unsigned NOT NULL,
    `name` varchar(20) NOT NULL,
    `value` varchar(50),
    shardKey bigint,
    PRIMARY KEY (t1_id),
    UNIQUE KEY `t1id_name` (t1_id, `name`),
    KEY `IDX_TA_ValueName` (`value`(20), `name`(10))
) ENGINE InnoDB;
}

setup s2 {
    CREATE TABLE t2 (
    id bigint NOT NULL,
    shardKey bigint,
    PRIMARY KEY (id)
) ENGINE InnoDB;
}

setup s3 {
    CREATE TABLE t2 (
    id bigint NOT NULL,
    shardKey bigint,
    PRIMARY KEY (id)
) ENGINE InnoDB;
    insert into t1(t1_id, name, value, shardKey) values (11, 'r', 'r', 1), (3, 'r', 'r', 0);
    insert into t2(id, shardKey) values (11, 1);
}

