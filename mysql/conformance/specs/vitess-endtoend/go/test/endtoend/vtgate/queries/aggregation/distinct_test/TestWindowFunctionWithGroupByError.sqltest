@database :memory:

setup s1 {
    CREATE TABLE emp (
    empno bigint NOT NULL,
    ename VARCHAR(10),
    job VARCHAR(9),
    mgr bigint,
    hiredate DATE,
    sal bigint,
    comm bigint,
    deptno bigint,
    PRIMARY KEY (empno)
) Engine = InnoDB
  COLLATE = utf8mb4_general_ci;
}

# mysql-error: 1056 42000 Can't group on 'fv'
@setup s1
test l74 {
    SELECT FIRST_VALUE(empno) OVER (PARTITION BY deptno ORDER BY hiredate DESC) AS fv, deptno FROM emp GROUP BY fv, deptno;
}
expect error {
}
