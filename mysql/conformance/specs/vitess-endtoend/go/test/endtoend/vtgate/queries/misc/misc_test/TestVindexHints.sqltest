@database :memory:

setup s1 {
    create table tbl
(
    id         bigint,
    unq_col    bigint,
    nonunq_col bigint not null,
    primary key (id),
    unique (unq_col)
) Engine = InnoDB;
}

setup s2 {
    insert into tbl(id, unq_col, nonunq_col) values (1,0,10), (2,10,10), (3,4,20), (4,30,20), (5,40,10);
}

@setup s1
