@database :memory:

setup s1 {
    create table user
(
    id   bigint,
    name varchar(255),
    primary key (id)
) Engine = InnoDB;
    create table music
(
    id      bigint,
    user_id bigint,
    primary key (id)
) Engine = InnoDB;
    set sql_mode = '';
}

@setup s1
test l35 {
    with d as (select id, count(*) as a from user) select d.a from music join d on music.user_id = d.id group by 1;
}
