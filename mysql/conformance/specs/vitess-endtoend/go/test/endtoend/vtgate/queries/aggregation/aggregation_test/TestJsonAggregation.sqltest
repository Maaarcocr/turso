@database :memory:

setup s1 {
    create table t3
(
    id5 bigint,
    id6 bigint,
    id7 bigint,
    primary key (id5)
) Engine = InnoDB;
}

setup s2 {
    insert into t3(id5, id6, id7) values(1,2,1), (2,2,4), (3,2,4), (4,1,2), (5,2,1), (6,2,6), (7,1,7);
}

@setup s1
test l823 {
    insert into t3(id5, id6, id7) values(1,2,1), (2,2,4), (3,2,4), (4,1,2), (5,2,1), (6,2,6), (7,1,7);
}
expect unordered {
}

@setup s1
@setup s2
test l825 {
    select count(1) from t3 where id6 = 2 group by id7 having json_arrayagg(id5+1) = json_array(2, 6);
}
expect unordered {
    2
}

@setup s1
@setup s2
test l826 {
    select count(1) from t3 where id6 = 2 group by id7 having json_objectagg(id5+1, id7) = json_object("2",1,"6",1);
}
expect unordered {
    2
}
