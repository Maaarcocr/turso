@database :memory:

setup s1 {
    create table user
(
    id   bigint,
    name varchar(255),
    primary key (id)
) Engine = InnoDB;
    create table music
(
    id      bigint,
    user_id bigint,
    primary key (id)
) Engine = InnoDB;
}

@setup s1
test l42 {
    with toto as (select user.id as oui, music.id as non from user join music on user.id = music.user_id order by user.name) select count(*) from toto;
}
expect unordered {
    0
}
