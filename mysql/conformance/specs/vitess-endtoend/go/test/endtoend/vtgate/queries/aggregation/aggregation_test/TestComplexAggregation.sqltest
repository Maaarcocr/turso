@database :memory:

setup s1 {
    CREATE TABLE t1 (
    t1_id bigint unsigned NOT NULL,
    `name` varchar(20) NOT NULL,
    `value` varchar(50),
    shardKey bigint,
    PRIMARY KEY (t1_id),
    UNIQUE KEY `t1id_name` (t1_id, `name`),
    KEY `IDX_TA_ValueName` (`value`(20), `name`(10))
) ENGINE InnoDB;
}

setup s2 {
    insert into t1(t1_id, `name`, `value`, shardkey) values(1,'a1','foo',100), (2,'b1','foo',200), (3,'c1','foo',300), (4,'a1','foo',100), (5,'d1','toto',200), (6,'c1','tata',893), (7,'a1','titi',2380), (8,'b1','tete',12833), (9,'e1','yoyo',783493);
    set @@sql_mode = ' ';
}

@setup s1
test l596 {
    insert into t1(t1_id, `name`, `value`, shardkey) values(1,'a1','foo',100), (2,'b1','foo',200), (3,'c1','foo',300), (4,'a1','foo',100), (5,'d1','toto',200), (6,'c1','tata',893), (7,'a1','titi',2380), (8,'b1','tete',12833), (9,'e1','yoyo',783493);
}
expect unordered {
}

@setup s1
@setup s2
test l599 {
    SELECT 1+COUNT(t1_id) FROM t1;
}
expect unordered {
    10
}

@setup s1
@setup s2
test l600 {
    SELECT COUNT(t1_id)+1 FROM t1;
}
expect unordered {
