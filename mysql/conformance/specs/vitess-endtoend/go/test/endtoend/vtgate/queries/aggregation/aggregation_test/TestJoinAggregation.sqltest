}

@setup s2
test l625 {
    SELECT t1.name, SUM(b.bet_amount) AS bet_amount FROM bet_logs as b LEFT JOIN t1 ON b.merchant_game_id = t1.t1_id GROUP BY b.merchant_game_id;
}
expect unordered {
    a1|15.30000000
    a1|37.80000000
    b1|37.80000000
    c1|60.30000000
}

@setup s2
test l626 {
    SELECT t1.name, CAST(SUM(b.bet_amount) AS DECIMAL(20,6)) AS bet_amount FROM bet_logs as b LEFT JOIN t1 ON b.merchant_game_id = t1.t1_id GROUP BY b.merchant_game_id;
}
expect unordered {
    a1|15.300000
    a1|37.800000
    b1|37.800000
    c1|60.300000
}
