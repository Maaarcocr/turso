@database :memory:

setup s1 {
    create table user
(
    id bigint primary key,
    col bigint,
    email varchar(20)
) Engine = InnoDB
  DEFAULT charset = utf8mb4
  COLLATE = utf8mb4_general_ci;
}

setup s2 {
    insert into user(id, col, email) values(1,1,'a'), (2,2,'Abc'), (3,3,'b'), (4,4,'c'), (5,2,'test'), (6,1,'test'), (7,2,'a'), (8,3,'b'), (9,4,'c3'), (10,2,'d');
}

@setup s1
test l94 {
