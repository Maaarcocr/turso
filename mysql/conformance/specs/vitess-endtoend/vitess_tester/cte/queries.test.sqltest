@setup s1
@setup s2
test l138 {
    WITH RECURSIVE hierarchy AS (SELECT id, name, manager_id
                             FROM employees
                             UNION ALL
                             SELECT id, name, manager_id
                             FROM employees
                             UNION
                             DISTINCT
                             SELECT id * 2, name, manager_id
                             from hierarchy
                             WHERE id < 10)
SELECT *
FROM hierarchy;
}
expect unordered {
    10|Engineer2|2
    12|Accountant1|3
    12|CFO|1
    14|Accountant2|3
    16|CEO|NULL
    16|CTO|1
    16|Engineer1|2
    1|CEO|NULL
    2|CEO|NULL
    2|CTO|1
    3|CFO|1
    4|CEO|NULL
    4|CTO|1
    4|Engineer1|2
    5|Engineer2|2
    6|Accountant1|3
    6|CFO|1
    7|Accountant2|3
    8|CEO|NULL
    8|CTO|1
    8|Engineer1|2
}

