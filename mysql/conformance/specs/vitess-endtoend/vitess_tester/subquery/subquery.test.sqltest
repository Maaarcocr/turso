@database :memory:

setup s1 {
    create table t1
(
    id1 bigint,
    id2 bigint,
    primary key (id1)
) Engine = InnoDB;
    create table t2
(
    id3 bigint,
    id4 bigint,
    primary key (id3)
) Engine = InnoDB;
    INSERT INTO t1 (id1, id2) VALUES
(0, 0),
(1, 1),
(2, 2),
(3, 3),
(4, 4);
    INSERT INTO t2 (id3, id4) VALUES
(0, 0),
(1, 1);
}

@setup s1
test l27 {
    SELECT count(*) FROM t1 WHERE id1 = 0 AND id1 IN (SELECT id4 FROM t2);
}
expect unordered {
    1
}

@setup s1
test l29 {
    SELECT count(*) FROM t1 WHERE id1 = 2 OR id1 IN (SELECT id4 FROM t2);
}
expect unordered {
    3
}

