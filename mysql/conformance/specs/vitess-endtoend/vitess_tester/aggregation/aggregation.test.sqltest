@setup s1
@setup s2
@setup s3
test l50 {
    select group_concat(t3.name SEPARATOR ', ') as "Group Name"
from t1
         join t2 on t1.id = t2.t1_id
         left join t3 on t1.id = t3.id
group by t1.id;
}
expect unordered {
    A
    B
    B
}

@setup s4
test l56 {
    select COUNT(*)
from (select 1 as one
      FROM `t3`
      WHERE `t3`.`name` = 'B'
      ORDER BY id DESC
      LIMIT 25 OFFSET 0) subquery_for_count;
}
expect unordered {
    4
}

@setup s1
@setup s2
@setup s5
test l63 {
    select u.id, u.t1_id, t.num_segments
from (select id, count(*) as num_segments from t1 group by 1 order by 2 desc limit 20) t
         join t2 u on u.id = t.id;
}
expect unordered {
    1|1|1
    2|2|1
    3|3|1
}

@setup s1
@setup s6
test l67 {
    select name
from (select name from t1 group by name having count(t1.id) > 1) t1;
}
expect unordered {
}

@setup s7
test l70 {
    select t1_id
from (select t1_id, col
      from t2
      group by 1, 2) t
group by 1;
}
expect unordered {
    1
    2
    3
}
