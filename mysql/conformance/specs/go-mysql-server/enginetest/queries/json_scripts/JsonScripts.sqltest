    0
}

test l1056 {
    SELECT JSON_EXTRACT('0.4', '$') = 0;
}
expect unordered {
    0
}

test l1060 {
    SELECT JSON_EXTRACT('0.4', '$') = 0.4;
}
expect unordered {
    1
}

@setup s30
test l1073 {
    select j->'$.x' = true from t;
}
expect unordered {
    0
    1
}

@setup s25
@setup s31
