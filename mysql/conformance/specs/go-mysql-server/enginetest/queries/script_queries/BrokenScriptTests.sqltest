  NULL, NULL, '', NULL, '', NULL, NULL, 0, 0);
    INSERT INTO YF VALUES ('', '', NULL, NULL, NULL);
    INSERT INTO XA VALUES ('', '', '', '', '', 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAC',
  '', '', '', '', '', '', '', '');
}

