@setup s5
test l16704 {
    SELECT DISTINCT YM.YW AS YW,
  (SELECT YW FROM YF WHERE YF.XB = YM.XB) AS YF_YW,
  (
    SELECT YW
    FROM yp
    WHERE
      yp.XJ = YM.XJ AND
      (yp.XL = YM.XL OR (yp.XL IS NULL AND YM.XL IS NULL)) AND
      yp.XT = nd.XT
    ) AS YJ,
  XE AS XE,
  XI AS YO,
  XK AS XK,
  XM AS XM,
  CASE
    WHEN YM.XO <> 'Z'
  THEN YM.XO
  ELSE NULL
  END AS XO
  FROM (
    SELECT YW, XB, XC, XE, XF, XI, XJ, XK,
      CASE WHEN XL = 'Z' OR XL = 'Z' THEN NULL ELSE XL END AS XL,
      XM, XO
    FROM XA
  ) YM
  INNER JOIN XS nd
    ON nd.XV = XF
  WHERE
    XB IN (SELECT XB FROM YF) AND
    (XF IS NOT NULL AND XF <> 'Z')
  UNION
  SELECT DISTINCT YL.YW AS YW,
    (
      SELECT YW
      FROM YF
      WHERE YF.XB = YL.XB
    ) AS YF_YW,
    (
      SELECT YW FROM yp
      WHERE
        yp.XJ = YL.XJ AND
        (yp.XL = YL.XL OR (yp.XL IS NULL AND YL.XL IS NULL)) AND
        yp.XT = YN.XT
    ) AS YJ,
    XE AS XE,
    XI AS YO,
    XK AS XK,
    XM AS XM,
    CASE WHEN YL.XO <> 'Z' THEN YL.XO ELSE NULL END AS XO
  FROM (
    SELECT YW, XB, XC, XE, XF, XI, XJ, XK,
      CASE WHEN XL = 'Z' OR XL = 'Z' THEN NULL ELSE XL END AS XL,
      XM, XO
      FROM XA
  ) YL
  INNER JOIN XS YN
    ON YN.XC = YL.XC
  WHERE
    XB IN (SELECT XB FROM YF) AND 
    (XF IS NULL OR XF = 'Z');
}
expect unordered {
    ||NULL|||||
}

