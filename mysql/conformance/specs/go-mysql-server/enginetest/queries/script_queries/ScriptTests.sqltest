test l2777 {
    WITH RECURSIVE
    rt (foo) AS (
        SELECT 1 as foo
        UNION ALL
        SELECT foo + 1 as foo FROM rt WHERE foo < 5
    ),
        ladder (depth, foo) AS (
        SELECT 1 as depth, NULL as foo from rt
        UNION ALL
        SELECT ladder.depth + 1 as depth, rt.foo
        FROM ladder JOIN rt WHERE ladder.foo = rt.foo
    )
SELECT * FROM ladder;
}
expect unordered {
    1|NULL
    1|NULL
    1|NULL
    1|NULL
    1|NULL
}

