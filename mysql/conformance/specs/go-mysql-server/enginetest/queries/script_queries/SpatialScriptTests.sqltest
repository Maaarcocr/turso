test l15788 {
    SELECT ST_ASWKT(ST_CONVEXHULL(MULTIPOINT(POINT(0,0),POINT(1,1),POINT(2,2))));
}
expect unordered {
    LINESTRING(0 0,2 2)
}

test l15793 {
    SELECT ST_ASWKT(ST_CONVEXHULL(MULTIPOINT(POINT(0,0),POINT(4,0),POINT(4,4),POINT(0,4))));
}
expect unordered {
    POLYGON((0 0,4 0,4 4,0 4,0 0))
}

test l15798 {
    SELECT ST_ASWKT(ST_CONVEXHULL(MULTIPOINT(POINT(0,0),POINT(4,0),POINT(4,4),POINT(0,4),POINT(2,2))));
}
expect unordered {
    POLYGON((0 0,4 0,4 4,0 4,0 0))
}

test l15802 {
    SELECT ST_CONVEXHULL(NULL);
}
expect unordered {
    NULL
}

test l15816 {
    SELECT ST_ISSIMPLE(POINT(0,0));
}
expect unordered {
    1
}

test l15821 {
    SELECT ST_ISSIMPLE(LINESTRING(POINT(0,0),POINT(1,1),POINT(2,0)));
}
expect unordered {
    1
}

test l15826 {
    SELECT ST_ISSIMPLE(LINESTRING(POINT(0,0),POINT(2,2),POINT(2,0),POINT(0,2)));
}
expect unordered {
    0
}

test l15831 {
    SELECT ST_ISSIMPLE(MULTIPOINT(POINT(0,0),POINT(1,1)));
}
expect unordered {
    1
}

test l15836 {
    SELECT ST_ISSIMPLE(MULTIPOINT(POINT(0,0),POINT(0,0)));
}
expect unordered {
    0
}

test l15840 {
    SELECT ST_ISSIMPLE(NULL);
}
expect unordered {
    NULL
}

test l15854 {
    SELECT ST_ASWKT(ST_VALIDATE(POINT(1,2)));
}
expect unordered {
    POINT(1 2)
}

test l15859 {
    SELECT ST_ASWKT(ST_VALIDATE(POLYGON(LINESTRING(POINT(0,0),POINT(1,0),POINT(1,1),POINT(0,0)))));
}
expect unordered {
    POLYGON((0 0,1 0,1 1,0 0))
}

test l15864 {
    SELECT ST_ASWKT(ST_VALIDATE(LINESTRING(POINT(0,0),POINT(1,1))));
}
expect unordered {
    LINESTRING(0 0,1 1)
}

test l15868 {
    SELECT ST_VALIDATE(NULL);
}
expect unordered {
    NULL
}

test l15882 {
    SELECT ST_GEOHASH(0, 0, 5);
}
expect unordered {
    s0000
}

test l15887 {
    SELECT ST_GEOHASH(POINT(0, 0), 5);
}
expect unordered {
    s0000
}

test l15892 {
    SELECT LEFT(ST_GEOHASH(-87.65, 41.85, 10), 5);
}
expect unordered {
    dp3wj
}

test l15896 {
    SELECT ST_GEOHASH(NULL, NULL, 5);
}
expect unordered {
    NULL
}

test l15907 {
    SELECT ROUND(ST_LATFROMGEOHASH('s0000'), 1);
}
expect unordered {
    0
}

test l15911 {
    SELECT ROUND(ST_LONGFROMGEOHASH('s0000'), 1);
}
expect unordered {
    0
}

test l15915 {
    SELECT ST_LATFROMGEOHASH(NULL);
}
expect unordered {
    NULL
}

test l15925 {
    SELECT ROUND(ST_X(ST_POINTFROMGEOHASH('s0000', 0)), 1);
}
expect unordered {
    0
}

test l15929 {
    SELECT ROUND(ST_Y(ST_POINTFROMGEOHASH('s0000', 0)), 1);
}
expect unordered {
    0
}

test l15933 {
    SELECT ST_POINTFROMGEOHASH(NULL, 0);
}
expect unordered {
    NULL
}
