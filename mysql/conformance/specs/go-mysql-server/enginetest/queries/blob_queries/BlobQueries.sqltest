@database :memory:

setup s1 {
    create table blobt (i bigint primary key, b longblob);
    insert into blobt values
    (1, 'first row'),
    (2, 'second row'),
    (3, 'third row');
}

setup s2 {
    create table textt (i bigint primary key, t text);
    insert into textt values
    (1, 'first row'),
    (2, 'second row'),
    (3, 'third row');
}

@setup s1
test l24 {
    select i, hex(b) from blobt;
}
expect unordered {
    1|666972737420726F77
    2|7365636F6E6420726F77
    3|746869726420726F77
}

@setup s1
test l32 {
    select * from blobt where i = 1;
}
expect unordered {
    1|first row
}

@setup s1
test l38 {
    select * from blobt order by b desc;
}
expect {
    3|third row
    2|second row
    1|first row
}

@setup s1
test l46 {
    select * from blobt where b <= 'second row';
}
expect unordered {
    1|first row
    2|second row
}

@setup s2
test l53 {
    select i, hex(t) from textt;
}
expect unordered {
    1|666972737420726F77
    2|7365636F6E6420726F77
    3|746869726420726F77
}

@setup s2
test l61 {
    select * from textt where i = 1;
}
expect unordered {
    1|first row
}

@setup s2
test l67 {
    select * from textt order by t desc;
}
expect {
    3|third row
    2|second row
    1|first row
}

@setup s2
test l75 {
    select * from textt where t <= 'second row';
}
expect unordered {
    1|first row
    2|second row
}
