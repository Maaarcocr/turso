}

setup s11 {
    CREATE TABLE t (pk INT PRIMARY KEY, other INT);
    INSERT INTO t VALUES (1, 1), (2, 2), (3, 3);
    CREATE PROCEDURE fragile() select other from t;
    CREATE PROCEDURE stable() select pk from t;
}

setup s12 {
