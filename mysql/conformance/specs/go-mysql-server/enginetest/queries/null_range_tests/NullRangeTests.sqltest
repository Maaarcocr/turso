@database :memory:

setup s1 {
    create table null_ranges (x int primary key, y int);
    create index idx1 on null_ranges (y);
    insert into null_ranges values
    (0,0),
    (1,1),
    (2,2),
    (3,null),
    (4,null);
}

@setup s1
test l23 {
    select * from null_ranges where y IS NULL or y < 1;
}
expect unordered {
    0|0
    3|NULL
    4|NULL
}

