test l763 {
    SELECT * FROM JSON_TABLE('[\{"a":"3"\},\{"a":2\},\{"b":1\},\{"a":0\},\{"a":[1,2]\}]', "$[*]" COLUMNS (rowid FOR ORDINALITY, ac VARCHAR(100) PATH "$.a" DEFAULT '111' ON EMPTY DEFAULT '999' ON ERROR, aj JSON PATH "$.a" DEFAULT '\{"x": 333\}' ON EMPTY, bx INT EXISTS PATH "$.b")) AS tt;
}
expect unordered {
    1|3|"3"|0
    2|2|2|0
    3|111|\{"x": 333\}|1
    4|0|0|0
    5|999|[1, 2]|0
}

test l773 {
    SELECT * FROM JSON_TABLE('[\{"x":2,"y":"8"\},\{"x":"3","y":"7"\},\{"x":"4","y":6\}]', "$[*]" COLUMNS (xval VARCHAR(100) PATH "$.x", yval VARCHAR(100) PATH "$.y")) AS  jt1;
}
expect unordered {
    2|8
    3|7
    4|6
}

test l781 {
