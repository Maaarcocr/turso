@database :memory:

setup s1 {
    create table t (i int, j json);
    insert into t values (1, '["test"]');
}

# mysql-error: 1109 42S02 Unknown table 'tt' in a table function argument
@setup s1
test l800 {
    with tt as (select * from t) select * from json_table(tt.j, '$[*]' columns (a varchar(10) path '$')) as jt;
}
expect error {
}

# mysql-error: 1210 HY000 Incorrect arguments to JSON_TABLE
@setup s1
test l804 {
    with tt as (select * from t) select * from tt, json_table(tt.j, '$[*]' columns (a varchar(10) path '$')) as jt;
}
expect error {
}

test l815 {
    SELECT * FROM JSON_TABLE('[ \{"c1": null\} ]', '$[*]' COLUMNS( c1 INT PATH '$.c1' ERROR ON ERROR )) as jt;
}
expect unordered {
    NULL
}

test l821 {
    SELECT * FROM JSON_TABLE('[\{"a":"3"\},\{"a":2\},\{"b":1\},\{"a":0\},\{"a":[1,2]\}]', "$[*]" COLUMNS(rowid FOR ORDINALITY, ac VARCHAR(100) PATH "$.a" DEFAULT '111' ON EMPTY DEFAULT '999' ON ERROR, aj JSON PATH "$.a" DEFAULT '\{"x": 333\}' ON EMPTY, bx INT EXISTS PATH "$.b")) AS tt;
}
expect unordered {
    1|3|"3"|0
    2|2|2|0
    3|111|\{"x": 333\}|1
    4|0|0|0
    5|999|[1, 2]|0
}

test l831 {
    SELECT * FROM JSON_TABLE('[ \{"a": 1, "b": [11,111]\}, \{"a": 2, "b": [22,222]\}, \{"a":3\}]', '$[*]' COLUMNS(a INT PATH '$.a', NESTED PATH '$.b[*]' COLUMNS (b INT PATH '$'))) AS jt WHERE b IS NOT NULL;
}
expect unordered {
    1|11
    1|111
    2|22
    2|222
}
