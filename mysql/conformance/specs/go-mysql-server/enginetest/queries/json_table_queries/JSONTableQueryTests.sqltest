@database :memory:

setup s1 {
    create table one_pk (pk smallint primary key, c1 smallint, c2 smallint, c3 smallint, c4 smallint, c5 smallint);
    insert into one_pk values
    (0,0,1,2,3,4),
    (1,10,11,12,13,14),
    (2,20,21,22,23,24),
    (3,30,31,32,33,34);
}

test l24 {
    SELECT * FROM JSON_TABLE(NULL,'$[*]' COLUMNS(x int path '$.a')) as t;
}
expect unordered {
}

test l28 {
    SELECT * FROM JSON_TABLE('\{\}','$[*]' COLUMNS(x int path '$.a')) as t;
}
expect unordered {
}

test l32 {
    SELECT * FROM JSON_TABLE('\{"a":1\}','$.b' COLUMNS(x varchar(100) path '$.a')) as tt;
}
expect unordered {
}

test l36 {
    SELECT * FROM JSON_TABLE('[\{"a":1\},\{"a":2\}]','$[*]' COLUMNS(x varchar(100) path '$.a')) as tt;
}
expect unordered {
    1
    2
}

test l43 {
    SELECT * FROM JSON_TABLE('[\{"a":1, "b":2\},\{"a":3, "b":4\}]',"$[*]" COLUMNS(x int path '$.a', y int path '$.b')) as tt;
}
expect unordered {
    1|2
    3|4
}

test l50 {
    SELECT * FROM JSON_TABLE('[\{"a":1.5, "b":2.25\},\{"a":3.125, "b":4.0625\}]','$[*]' COLUMNS(x float path '$.a', y float path '$.b')) as tt;
}
expect unordered {
    1.5|2.25
    3.125|4.0625
}

test l57 {
    SELECT * FROM JSON_TABLE(concat('[\{\},','\{\}]'),'$[*]' COLUMNS(x varchar(100) path '$.a',y varchar(100) path '$.b')) as t;
}
expect unordered {
    NULL|NULL
    NULL|NULL
}

test l64 {
    select * from JSON_TABLE('[\{"a":1\},\{"a":2\}]', '$[*]' COLUMNS(x int path '$.a')) as t1 join JSON_TABLE('[\{"a":1\},\{"a":2\}]', '$[*]' COLUMNS(x int path '$.a')) as t2;
}
expect unordered {
    1|1
    1|2
    2|1
    2|2
}

@setup s1
test l73 {
    select * from JSON_TABLE('[\{"a":1\},\{"a":2\}]', '$[*]' COLUMNS(x int path '$.a')) as t1 join one_pk order by x, pk;
}
expect {
    1|0|0|1|2|3|4
    1|1|10|11|12|13|14
    1|2|20|21|22|23|24
    1|3|30|31|32|33|34
    2|0|0|1|2|3|4
    2|1|10|11|12|13|14
    2|2|20|21|22|23|24
    2|3|30|31|32|33|34
}

@setup s1
test l86 {
    select * from one_pk join JSON_TABLE('[\{"a":1\},\{"a":2\}]', '$[*]' COLUMNS(x int path '$.a')) as t1 order by x, pk;
}
expect {
    0|0|1|2|3|4|1
    1|10|11|12|13|14|1
    2|20|21|22|23|24|1
    3|30|31|32|33|34|1
    0|0|1|2|3|4|2
    1|10|11|12|13|14|2
    2|20|21|22|23|24|2
    3|30|31|32|33|34|2
}

test l99 {
    select * from JSON_TABLE('[\{"a":1\},\{"a":2\}]', '$[*]' COLUMNS(x int path '$.a')) as t1 union select * from JSON_TABLE('[\{"b":3\},\{"b":4\}]', '$[*]' COLUMNS(y int path '$.b')) as t2;
}
expect unordered {
    1
    2
    3
    4
}

@setup s1
test l108 {
    select * from one_pk where pk in (select x from JSON_TABLE('[\{"a":1\},\{"a":2\}]', '$[*]' COLUMNS(x int path '$.a')) as t);
}
expect unordered {
    1|10|11|12|13|14
    2|20|21|22|23|24
}

test l115 {
    select * from JSON_TABLE('[\{"a":1\},\{"a":2\}]', '$[*]' COLUMNS(x int path '$.a')) t1 where x in (select y from JSON_TABLE('[\{"b":1\},\{"b":100\}]', '$[*]' COLUMNS(y int path '$.b')) as t2);
}
expect unordered {
    1
}

test l121 {
    with c as (select jt.a from json_table('[\{"a":1,"b":2,"c":3\},\{"a":4,"b":5,"c":6\},\{"a":7,"b":8,"c":9\}]', '$[*]' columns (a int path '$.a')) as jt) select * from c;
}
expect unordered {
    1
    4
    7
}

test l129 {
    select * from json_table('[\{"a":1,"b":2,"c":3\},\{"a":4,"b":5,"c":6\},\{"a":7,"b":8,"c":9\}]', '$[*]' columns (a int path '$.a')) as jt
union
select * from json_table('[\{"a":1,"b":2,"c":3\},\{"a":4,"b":5,"c":6\},\{"a":7,"b":8,"c":9\}]', '$[*]' columns (b int path '$.b')) as jt
union
select * from json_table('[\{"a":1,"b":2,"c":3\},\{"a":4,"b":5,"c":6\},\{"a":7,"b":8,"c":9\}]', '$[*]' columns (c int path '$.c')) as jt;
}
expect unordered {
    1
    2
    3
    4
    5
    6
    7
    8
    9
}

test l143 {
    select * from json_table('["foo", "bar"]', "$[*]" columns(tag text path '$')) as tags where tag like 'foo';
}
expect unordered {
    foo
}
