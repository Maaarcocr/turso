test l714 {
    SELECT count(*)
FROM
JSON_TABLE(
	'[\{"a":1.5, "b":2.25\},\{"a":3.125, "b":4.0625\}]',
	'$[*]' COLUMNS(x float path '$.a', y float path '$.b')
) as t1
join
JSON_TABLE(
	'[\{"c":2, "d":3\},\{"c":4, "d":5\}]',
	'$[*]' COLUMNS(z float path '$.c', w float path '$.d')
) as t2
on w = 0;
}
expect unordered {
    0
}

