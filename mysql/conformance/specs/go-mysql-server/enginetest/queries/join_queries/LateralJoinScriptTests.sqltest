    insert into three_pk values (0,0,0,100), (0,1,1,101), (1,0,1,110), (1,1,0,111);
}

@setup s1
@setup s2
test l1448 {
    select * from t, lateral (select * from t1 where t.i = t1.j) as tt order by t.i, tt.j;
}
expect {
    1|1
}

@setup s1
@setup s2
test l1454 {
    select * from t, lateral (select * from t1 where t.i != t1.j) as tt order by tt.j, t.i;
}
expect {
    2|1
    3|1
    1|4
    2|4
    3|4
    1|5
    2|5
    3|5
}

@setup s1
@setup s2
test l1467 {
    select * from t, t1, lateral (select * from t1 where t.i != t1.j) as tt where t.i > t1.j and t1.j = tt.j order by t.i, t1.j, tt.j;
}
expect {
    2|1|1
    3|1|1
}

@setup s1
@setup s2
test l1474 {
    select * from t, lateral (select * from t1 where t.i = t1.j) tt, lateral (select * from t1 where t.i != t1.j) as ttt order by t.i, tt.j, ttt.j;
}
expect {
    1|1|4
    1|1|5
}

@setup s1
@setup s3
test l1481 {
    WITH RECURSIVE cte(x) AS (SELECT 1 union all SELECT x + 1 from cte where x < 5) SELECT * FROM cte, lateral (select * from t where t.i = cte.x) tt;
}
expect unordered {
    1|1
    2|2
    3|3
}

