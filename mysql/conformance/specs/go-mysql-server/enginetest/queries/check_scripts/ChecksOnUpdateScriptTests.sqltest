@database :memory:

setup s1 {
    CREATE TABLE t1 (a INTEGER PRIMARY KEY, b INTEGER);
    ALTER TABLE t1 ADD CONSTRAINT chk1 CHECK (b > 10) NOT ENFORCED;
    ALTER TABLE t1 ADD CONSTRAINT chk2 CHECK (b > 0);
    ALTER TABLE t1 ADD CONSTRAINT chk3 CHECK ((a + b) / 2 >= 1) ENFORCED;
    INSERT INTO t1 VALUES (1,1);
}

setup s2 {
    CREATE TABLE sales (year_built int primary key, CONSTRAINT `valid_year_built` CHECK (year_built <= 2022));
    INSERT INTO sales VALUES (1981);
}

setup s3 {
    UPDATE sales JOIN (SELECT year_built FROM sales) AS t ON sales.year_built = t.year_built SET sales.year_built = 1901;
}

setup s4 {
    CREATE TABLE locations (state char(2) primary key, CONSTRAINT `state` CHECK (state != 'GA'));
    INSERT INTO locations VALUES ('WA');
}

setup s5 {
    UPDATE sales JOIN locations SET sales.year_built = 2000, locations.state = 'CA';
}

@setup s1
test l514 {
    SELECT * FROM t1;
}
expect unordered {
    1|1
}

