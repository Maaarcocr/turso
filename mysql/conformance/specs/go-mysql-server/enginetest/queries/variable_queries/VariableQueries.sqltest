@database :memory:

setup s1 {
    set @@auto_increment_increment = 100, sql_select_limit = 1;
}

setup s2 {
    SET @myvar = @@autocommit;
    SET autocommit = @myvar;
    SET @myvar2 = @myvar - 1, @myvar3 = @@autocommit - 1;
}

setup s3 {
