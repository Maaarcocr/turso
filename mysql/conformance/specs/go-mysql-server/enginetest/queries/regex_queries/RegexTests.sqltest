@setup s2
test l72 {
    SELECT REGEXP_LIKE('testing' COLLATE utf8mb4_0900_ai_ci, 'TESTING') FROM mytable;
}
expect unordered {
    1
    1
    1
}

@setup s2
test l80 {
    SELECT i, s, REGEXP_LIKE(s, '[a-z]+d row') FROM mytable;
}
expect unordered {
    1|first row|0
    2|second row|1
    3|third row|1
}

test l88 {
    SELECT REGEXP_REPLACE("0123456789", "[0-4]", "X");
}
expect unordered {
    XXXXX56789
}

