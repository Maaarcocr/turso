    SELECT REGEXP_LIKE('testing', 'TESTING', 'ci');
}
expect unordered {
    1
}

test l56 {
    SELECT REGEXP_LIKE('testing', 'TESTING', 'ic');
}
expect unordered {
    0
}

@setup s1
test l60 {
    SELECT REGEXP_LIKE(str, pattern, flags) from tests;
}
expect unordered {
    1
}

