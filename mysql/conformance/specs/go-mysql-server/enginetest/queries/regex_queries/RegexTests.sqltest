}

test l108 {
    SELECT REGEXP_REPLACE(CONCAT("abc123"), "[0-4]", "X");
}
expect unordered {
    abcXXX
}

@setup s2
test l112 {
    SELECT * FROM mytable WHERE s LIKE REGEXP_REPLACE("123456%r1o2w", "[0-9]", "");
}
expect unordered {
    1|first row
    2|second row
    3|third row
}

