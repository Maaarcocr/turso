    ["a", 1]|1
    \{"key1": "value1", "key2": "value2"\}|2
}

@setup s38
test l856 {
    SELECT pk, JSON_ARRAYAGG(v1) FROM (SELECT * FROM test ORDER BY pk) as sub GROUP BY pk, v1 ORDER BY pk;
}
expect {
    1|[["a", 1]]
    2|[\{"key1": "value1", "key2": "value2"\}]
}
