@setup s38
test l854 {
    SELECT * FROM test ORDER BY pk;
}
expect {
    1|["a", 1]
    2|\{"key1": "value1", "key2": "value2"\}
}

@setup s38
test l855 {
    SELECT v1, pk FROM test ORDER BY pk;
}
