@database :memory:

setup s1 {
    CREATE TABLE pkTable(pk int, val int, primary key(pk, val));
    INSERT INTO pkTable VALUES (1, 1), (2, 2), (3, 3);
}

setup s2 {
    UPDATE IGNORE pkTable set pk = pk + 1, val = val + 1;
}

setup s3 {
    CREATE TABLE idxTable(pk int primary key, val int UNIQUE);
    INSERT INTO idxTable VALUES (1, 1), (2, 2), (3, 3);
}

setup s4 {
    UPDATE IGNORE idxTable set val = val + 1;
}

setup s5 {
    UPDATE IGNORE pkTable set val = val + 1 where pk = 2;
}

setup s6 {
    UPDATE IGNORE pkTable SET pk = NULL;
}

setup s7 {
    UPDATE IGNORE pkTable SET val = NULL;
}

setup s8 {
    UPDATE IGNORE idxTable set pk = pk + 1, val = val + 1;
}

setup s9 {
    CREATE TABLE t1 (pk int primary key, v1 int, v2 int);
    INSERT INTO t1 VALUES (1, 1, 1);
}

setup s10 {
    UPDATE IGNORE t1 SET v1 = 'dsddads';
}

setup s11 {
    UPDATE IGNORE t1 SET pk = 'dasda', v2 = 'dsddads';
}

setup s12 {
    CREATE TABLE checksTable(pk int primary key);
    ALTER TABLE checksTable ADD CONSTRAINT mycx CHECK (pk < 5);
    INSERT INTO checksTable VALUES (1),(2),(3),(4);
}

setup s13 {
    UPDATE IGNORE checksTable SET pk = pk + 1 where pk = 4;
}

