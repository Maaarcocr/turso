@setup s1
test l452 {
    with t (n) as (select (1) from dual) UPDATE mytable set s = concat('updated ', i) where i in (select n from t);
    select * from mytable order by i;
}
expect {
    1|updated 1
    2|second row
    3|third row
}

@setup s1
test l462 {
    with recursive t (n) as (select (1) from dual union all select n + 1 from t where n < 2) UPDATE mytable set s = concat('updated ', i) where i in (select n from t);
    select * from mytable order by i;
}
expect {
    1|updated 1
    2|updated 2
    3|third row
}
