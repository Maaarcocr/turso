@database :memory:

setup s1 {
    create table mytable (i bigint primary key, s varchar(20) comment 'column s' NOT NULL);
    insert into mytable values
    (1, 'first row'),
    (2, 'second row'),
    (3, 'third row');
    create unique index mytable_s on mytable (s);
    create index mytable_i_s on mytable (i,s);
    create index `idx_si` on mytable (`s`,`i`);
    create view myview as SELECT * FROM mytable;
}

setup s2 {
    create table uv (u int primary key, v int);
    insert into uv values (0,3),(3,0),(2,1),(1,2);
}

setup s3 {
    create table wz (w int, z int);
    insert into wz values (0, 0), (1, 0), (1, 2);
}

setup s4 {
    create table xy (x int primary key, y int);
}

setup s5 {
    create table uv (u int primary key, v int);
    insert into xy values (0,0),(1,1),(2,2),(3,3);
    insert into uv values (0,3),(3,0),(2,1),(1,2);
}

setup s6 {
    insert into xy values (0,0),(1,1),(2,2),(3,3);
}

@setup s1
test l39 {
    SELECT i AS cOl FROM mytable;
}
expect unordered {
    1
    2
    3
}

@setup s1
test l49 {
    SELECT i AS cOl, s as COL FROM mytable;
}
expect unordered {
    1|first row
    2|second row
    3|third row
}

test l80 {
    select 1 as a order by a desc;
}
expect {
    1
}

@setup s2
test l86 {
    select v as u from uv order by u;
}
expect {
    0
    1
    2
    3
}

