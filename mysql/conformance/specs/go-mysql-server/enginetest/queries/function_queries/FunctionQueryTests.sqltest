test l1417 {
    SELECT JSON_MERGE_PRESERVE(val1, val2)
	              FROM (values
						 row('\{ "a": 1, "b": 2 \}','null'),
	                   row('\{ "a": 1, "b": 2 \}','"row one"'),
	                   row('\{ "a": 3, "c": 4 \}','4'),
	                   row('\{ "a": 5, "d": 6 \}','[true, true]'),
	                   row('\{ "a": 5, "d": 6 \}','\{ "a": 3, "e": 2 \}'))
	              test (val1, val2);
}
expect unordered {
    [\{"a": 1, "b": 2\}, "row one"]
    [\{"a": 1, "b": 2\}, null]
    [\{"a": 3, "c": 4\}, 4]
    [\{"a": 5, "d": 6\}, true, true]
    \{"a": [5, 3], "d": 6, "e": 2\}
}

