@setup s1
test l1910 {
    SELECT instr(s, 'row') as l FROM mytable ORDER BY i;
}
expect {
    7
    8
    7
}

@setup s1
test l1914 {
    SELECT instr(s, 'first') as l FROM mytable ORDER BY i;
}
expect {
    1
    0
    0
}

@setup s1
test l1918 {
    SELECT instr(s, 'o') as l FROM mytable ORDER BY i;
}
expect {
    8
    4
    8
}

@setup s1
test l1922 {
    SELECT instr(s, NULL) as l FROM mytable ORDER BY l;
}
expect {
    NULL
    NULL
    NULL
}

@setup s1
test l1926 {
    select locate("o", s) from mytable order by i;
}
expect {
    8
    4
    8
}

@setup s1
test l1930 {
    select locate("o", s, 5) from mytable order by i;
}
expect {
    8
    9
    8
}

@setup s1
test l1934 {
    select locate(upper("roW"), upper(s), power(10, 0)) from mytable order by i;
}
expect {
    7
    8
    7
}

@setup s1
test l1938 {
    select find_in_set('second row', s) from mytable;
}
expect unordered {
    0
    0
    1
}

@setup s1
test l1946 {
    select find_in_set(s, 'first row,second row,third row') from mytable;
}
expect unordered {
    1
    2
    3
}

@setup s1
test l1956 {
    select log2(i) from mytable order by i;
}
expect {
    0
    1
    1.584962500721156
}

