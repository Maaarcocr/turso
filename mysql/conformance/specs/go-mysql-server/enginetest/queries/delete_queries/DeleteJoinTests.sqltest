test l253 {
    DELETE mytable FROM mytable join tabletest on mytable.i=tabletest.i join JSON_TABLE('[\{"x": 1\},\{"x": 2\}]', '$[*]' COLUMNS (x INT PATH '$.x')) as jt on jt.x=mytable.i;
    SELECT (select count(*) FROM mytable), (SELECT count(*) from tabletest);
}
