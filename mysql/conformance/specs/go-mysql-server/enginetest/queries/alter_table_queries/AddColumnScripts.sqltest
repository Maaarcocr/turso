@database :memory:

setup s1 {
    create table mytable (i bigint primary key, s varchar(20) comment 'column s' NOT NULL);
    insert into mytable values
    (1, 'first row'),
    (2, 'second row'),
    (3, 'third row');
    create unique index mytable_s on mytable (s);
    create index mytable_i_s on mytable (i,s);
    create index `idx_si` on mytable (`s`,`i`);
    create view myview as SELECT * FROM mytable;
}

setup s2 {
    ALTER TABLE mytable ADD COLUMN i2 INT COMMENT 'hello' default 42;
}

setup s3 {
    ALTER TABLE mytable ADD COLUMN s2 TEXT COMMENT 'hello' AFTER i;
}

setup s4 {
    ALTER TABLE mytable ADD COLUMN s3 VARCHAR(25) COMMENT 'hello' default 'yay' FIRST;
}

setup s5 {
    ALTER TABLE mytable ADD COLUMN s5 VARCHAR(26), ADD COLUMN s6 VARCHAR(27);
}

setup s6 {
    create table t (i int primary key, j int);
    insert into t values (1, 2);
}

setup s7 {
    alter table t add column k int check (k > 0);
}

@setup s1
test l1970 {
    ALTER TABLE mytable ADD COLUMN i2 INT COMMENT 'hello' default 42;
}
expect unordered {
}

@setup s1
@setup s2
test l1974 {
    SHOW FULL COLUMNS FROM mytable;
}
expect {
    i|bigint|NULL|NO|PRI|NULL||select,insert,update,references|
    s|varchar(20)|utf8mb4_0900_ai_ci|NO|UNI|NULL||select,insert,update,references|column s
    i2|int|NULL|YES||42||select,insert,update,references|hello
}

@setup s1
@setup s2
test l1984 {
    SELECT * FROM mytable ORDER BY i;
}
expect {
    1|first row|42
    2|second row|42
    3|third row|42
}

