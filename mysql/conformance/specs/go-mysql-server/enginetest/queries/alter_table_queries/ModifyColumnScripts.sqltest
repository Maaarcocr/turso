@database :memory:

setup s1 {
    create table mytable (i bigint primary key, s varchar(20) comment 'column s' NOT NULL);
    insert into mytable values
    (1, 'first row'),
    (2, 'second row'),
    (3, 'third row');
    create unique index mytable_s on mytable (s);
    create index mytable_i_s on mytable (i,s);
    create index `idx_si` on mytable (`s`,`i`);
    create view myview as SELECT * FROM mytable;
    drop index mytable_s on mytable;
    drop index mytable_i_s on mytable;
    drop index idx_si on mytable;
}

setup s2 {
    ALTER TABLE mytable MODIFY COLUMN i bigint NOT NULL COMMENT 'modified';
}

setup s3 {
    ALTER TABLE mytable MODIFY COLUMN i TINYINT NOT NULL COMMENT 'yes' AFTER s;
}

setup s4 {
    ALTER TABLE mytable MODIFY COLUMN i BIGINT NOT NULL COMMENT 'ok' FIRST;
}

setup s5 {
    ALTER TABLE mytable MODIFY COLUMN s VARCHAR(20) NULL COMMENT 'changed';
}

setup s6 {
    ALTER TABLE mytable MODIFY i BIGINT auto_increment;
}

setup s7 {
    insert into mytable (s) values ('new row');
}

setup s8 {
    alter table mytable add column i2 bigint;
}

setup s9 {
    ALTER TABLE mytable MODIFY COLUMN i BIGINT NOT NULL COMMENT 'ok' FIRST;
}

setup s10 {
    ALTER TABLE mytable MODIFY COLUMN s VARCHAR(20) NULL COMMENT 'changed';
}

setup s11 {
    create table t(pk int primary key);
    alter table t modify column pk int check(pk < 10);
}

