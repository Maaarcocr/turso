@setup s1
test l32 {
    select team as f from members order by id, f;
}
expect {
    red
    red
    orange
    orange
    orange
    purple
}

@setup s1
test l36 {
    SELECT team, COUNT(*) FROM members GROUP BY team ORDER BY 2;
}
expect {
    purple|1
    red|2
    orange|3
}

@setup s1
test l44 {
    SELECT team, COUNT(*) FROM members GROUP BY 1 ORDER BY 2;
}
expect {
    purple|1
    red|2
    orange|3
}

@setup s1
test l56 {
    SELECT DISTINCT BINARY t1.id as id FROM members AS t1 JOIN members AS t2 ON t1.id = t2.id WHERE t1.id > 0 ORDER BY BINARY t1.id;
}
expect {
    3
    4
    5
    6
    7
    8
}

