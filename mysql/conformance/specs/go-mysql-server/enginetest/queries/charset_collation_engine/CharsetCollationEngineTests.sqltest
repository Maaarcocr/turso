    SELECT HEX(_utf8mb4'abc' COLLATE utf8mb4_0900_bin);
}
expect unordered {
    616263
}

test l1045 {
    SELECT UNHEX(_utf8mb4'616263' COLLATE utf8mb4_0900_bin);
}
expect unordered {
    abc
}

test l1062 {
    SELECT SUBSTRING(_utf8mb4'abcd' COLLATE utf8mb4_0900_bin, 2, 2);
}
expect unordered {
    bc
}

test l1085 {
    SELECT TO_BASE64(_utf8mb4'abc' COLLATE utf8mb4_0900_bin);
}
expect unordered {
    YWJj
}

test l1108 {
    SELECT FROM_BASE64(_utf8mb4'YWJj' COLLATE utf8mb4_0900_bin);
}
expect unordered {
    abc
}

test l1125 {
    SELECT TRIM(_utf8mb4' abc ' COLLATE utf8mb4_0900_bin);
}
expect unordered {
    abc
}

test l1148 {
    SELECT RTRIM(_utf8mb4' abc ' COLLATE utf8mb4_0900_bin);
}
expect raw {
 abc
}

test l1171 {
    SELECT LTRIM(_utf8mb4' abc ' COLLATE utf8mb4_0900_bin);
}
expect raw {
abc 
}

test l1194 {
    SELECT BINARY(_utf8mb4'abc' COLLATE utf8mb4_0900_bin);
}
expect unordered {
    abc
}

test l1217 {
    SELECT CAST(_utf8mb4'abc' COLLATE utf8mb4_0900_bin AS BINARY);
}
expect unordered {
    abc
}

