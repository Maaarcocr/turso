@setup s1
test l892 {
    SELECT s.st, (SELECT count(*) FROM c WHERE c.bill=s.st) + (SELECT count(*) FROM o WHERE o.ship=s.st) FROM (SELECT c.bill AS st FROM c UNION SELECT o.ship AS st FROM o) s ORDER BY s.st;
}
expect {
    NULL|0
    CA|5
    FL|1
    MA|1
    TX|3
    WA|1
    WY|1
}

@setup s1
test l904 {
    SELECT c.c_id, o.ship, count(*) AS cust, (SELECT count(*) FROM o AS o2 WHERE o2.ship = o.ship AND o2.c_id <> c.c_id) AS other  FROM c INNER JOIN o ON c.c_id=o.c_id GROUP BY c.c_id, o.ship;
}
expect unordered {
    1|CA|3|1
    2|CA|1|3
    2|NULL|1|0
    2|TX|1|0
    4|NULL|1|0
    4|WY|1|0
    6|WA|1|0
}

@setup s1
test l916 {
    SELECT c.c_id, o.o_id, (SELECT max(CASE WHEN c2.bill > o2.ship THEN c2.bill ELSE o2.ship END) FROM c AS c2, o AS o2 WHERE c2.c_id=o2.c_id AND c2.c_id=c.c_id)  FROM c LEFT JOIN o ON c.c_id=o.c_id ORDER BY c.c_id, o.o_id;
}
expect {
    1|10|CA
    1|20|CA
    1|30|CA
    2|40|TX
    2|50|TX
    2|60|TX
    3|NULL|NULL
    4|70|WY
    4|80|WY
    5|NULL|NULL
    6|90|WA
}

