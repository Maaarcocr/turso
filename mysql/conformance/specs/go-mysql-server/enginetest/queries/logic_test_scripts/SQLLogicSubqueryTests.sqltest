@setup s1
test l954 {
    SELECT * FROM (SELECT c_id AS c_c_id, bill FROM c) sq1, LATERAL (SELECT row_number() OVER () AS rownum FROM o WHERE c_id = c_c_id) sq2 ORDER BY c_c_id, bill, rownum;
}
expect {
    1|CA|1
    1|CA|2
    1|CA|3
    2|TX|1
    2|TX|2
    2|TX|3
    4|TX|1
    4|TX|2
    6|FL|1
}

@setup s1
test l968 {
    SELECT *  FROM (SELECT bill FROM c) sq1, LATERAL (SELECT row_number() OVER (PARTITION BY bill) AS rownum FROM o WHERE ship = bill) sq2 ORDER BY bill, rownum;
}
expect {
    CA|1
    CA|2
    CA|3
    CA|4
    TX|1
    TX|1
}

@setup s1
test l989 {
    SELECT c_cnt, o_cnt, c_cnt + o_cnt AS total  FROM (VALUES ROW((SELECT count(*) FROM c), (SELECT count(*) FROM o))) AS v(c_cnt, o_cnt)  WHERE c_cnt > 0 AND o_cnt > 0;
}
expect unordered {
    6|9|15
}

