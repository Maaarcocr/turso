@database :memory:

setup s1 {
    CREATE TABLE one_uniq(not_pk int, value int UNIQUE);
    INSERT INTO one_uniq values (1, 1);
}

setup s2 {
    INSERT IGNORE INTO one_uniq VALUES (3, 2), (2, 1), (4, null), (5, null);
}

setup s3 {
    CREATE TABLE two_uniq(not_pk int, col1 int, col2 int, UNIQUE KEY col1_col2_uniq (col1, col2));
    INSERT INTO two_uniq values (1, 1, 1);
}

setup s4 {
    INSERT IGNORE INTO two_uniq VALUES (4, 1, 2), (5, 2, 1), (6, null, 1), (7, null, 1), (12, 1, 1), (8, 1, null), (9, 1, null), (10, null, null), (11, null, null);
}

setup s5 {
    CREATE TABLE keyless(pk int, val int);
}

setup s6 {
    INSERT INTO keyless values (1, 1), (2, 2), (3, 3);
}

setup s7 {
    INSERT IGNORE INTO keyless VALUES (1, 2);
}

setup s8 {
    DELETE FROM keyless where pk = 1 and val = 2;
}

setup s9 {
    ALTER TABLE keyless ADD CONSTRAINT c UNIQUE(val);
}

setup s10 {
    INSERT INTO keyless VALUES (1, 1), (2, 2), (3, 3);
}

setup s11 {
    UPDATE IGNORE keyless SET val = 2 where pk = 1;
}

setup s12 {
    UPDATE IGNORE keyless SET val = 1 where pk = 1;
}

setup s13 {
    ALTER TABLE keyless ADD CONSTRAINT c UNIQUE(val);
}

setup s14 {
    UPDATE IGNORE keyless SET val = 3 where pk = 1;
}

setup s15 {
    UPDATE IGNORE keyless SET val = val + 1 ORDER BY pk;
}

@setup s1
