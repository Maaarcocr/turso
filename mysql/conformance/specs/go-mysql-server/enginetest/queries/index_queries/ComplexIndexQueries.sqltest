@setup s4
test l2829 {
    select * from comp_index_t3 where v2 = 'a';
}
expect unordered {
    0|a|a
}

@setup s4
test l2835 {
    select * from comp_index_t3 where v2 like 'a%';
}
expect unordered {
    0|a|a
    1|ab|ab
    2|abc|abc
    3|abcde|abcde
}
