test l9818 {
    SELECT STR_TO_DATE('01/02/99 314', '%m/%e/%y %f');
}
expect unordered {
    1999-01-02 00:00:00.314000
}

test l9822 {
    SELECT STR_TO_DATE('01/02/99 0', '%m/%e/%y %f');
}
expect unordered {
    1999-01-02 00:00:00.000000
}

test l9826 {
    SELECT STR_TO_DATE('01/02/99 05:14:12 PM', '%m/%e/%y %r');
}
expect unordered {
    1999-01-02 17:14:12
}

test l9830 {
    SELECT STR_TO_DATE('May 3, 10:23:00 2000', '%b %e, %H:%i:%s %Y');
}
expect unordered {
    2000-05-03 10:23:00
}

test l9834 {
    SELECT STR_TO_DATE('May 3, 10:23:00 PM 2000', '%b %e, %h:%i:%s %p %Y');
}
expect unordered {
