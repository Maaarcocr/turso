test l9774 {
    SELECT STR_TO_DATE('Jan 3, 2000', '%b %e, %Y');
}
expect unordered {
    2000-01-03
}

test l9778 {
    SELECT STR_TO_DATE('01,5,2013', '%d,%m,%Y');
}
expect unordered {
    2013-05-01
}

test l9782 {
    SELECT STR_TO_DATE('May 1, 2013','%M %d,%Y');
}
expect unordered {
    2013-05-01
}

test l9786 {
    SELECT STR_TO_DATE('a09:30:17','a%h:%i:%s');
}
expect unordered {
    09:30:17
}

