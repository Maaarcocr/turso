@setup s11
@setup s17
test l8222 {
    select * from mytable,
	lateral (
	with recursive cte(a) as (
		select y from xy
		union
		select x from cte
		join
		xy
		on x = a
		)
	select * from cte
) sqa 
where i = a
order by i;
}
expect {
    1|first row|1
    2|second row|2
    3|third row|3
}

@setup s11
@setup s17
test l8244 {
    select * from mytable,
	lateral (
	with recursive cte(a) as (
		select y from xy
		union
		select x from cte
		join
		(
			select * 
			from xy
			where x = 1
		 ) sqa1
		on x = a
		limit 3
		)
	select * from cte
) sqa2
where i = a
order by i;
}
expect {
    1|first row|1
    2|second row|2
}

