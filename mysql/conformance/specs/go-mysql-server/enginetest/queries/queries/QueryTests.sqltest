@setup s24
test l2442 {
    WITH RECURSIVE bus_dst as (
				SELECT origin as dst FROM bus_routes WHERE origin='New York'
				UNION
				SELECT bus_routes.dst FROM bus_routes JOIN bus_dst ON bus_dst.dst= bus_routes.origin
			)
			SELECT * FROM bus_dst
			ORDER BY dst;
}
expect {
    Boston
    New York
    Raleigh
    Washington
}

@setup s24
test l2458 {
