@database :memory:

setup s1 {
    CREATE TABLE `keyless` (   `c0` bigint,   `c1` bigint );
    insert into keyless values
    (0,0),
    (1,1),
    (1,1),
    (2,2);
}

@setup s1
test l9406 {
    SELECT * FROM keyless ORDER BY c0;
}
