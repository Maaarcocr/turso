@database :memory:

setup s1 {
    create table mytable (i bigint primary key, s varchar(20) comment 'column s' NOT NULL);
    insert into mytable values
    (1, 'first row'),
    (2, 'second row'),
    (3, 'third row');
    create unique index mytable_s on mytable (s);
    create index mytable_i_s on mytable (i,s);
    create index `idx_si` on mytable (`s`,`i`);
    create view myview as SELECT * FROM mytable;
    CREATE TABLE `fk_tbl` (   `pk` bigint NOT NULL,   `a` bigint,   `b` varchar(20),   PRIMARY KEY (`pk`) );
}

test l9472 {
    with recursive t (n) as (select sum('1') from dual union all select (2.00) from dual) select sum(n) from t;
}
expect unordered {
    3
}

test l9478 {
    with recursive t (n) as (select sum(1.0) from dual union all select n+1 from t where n < 10) select sum(n) from t;
}
expect unordered {
    55.0
}

@setup s1
test l9485 {
    with recursive MYTABLE(j) as (select 2 union select MYTABLE.j from MYTABLE join mytable on MYTABLE.j = mytable.i) select j from MYTABLE;
}
expect unordered {
    2
}

@setup s1
test l9490 {
    with recursive MYTABLE(j) as (select 2 union select MYTABLE.j from MYTABLE join mytable on MYTABLE.j = mytable.i) select i from mytable;
}
expect unordered {
    1
    2
    3
}

test l9495 {
    with a(j) as (select 1), b(i) as (select 2) (select j from a union select i from b order by 1 desc) union select j from a;
}
expect unordered {
    1
    2
}

test l9500 {
    with a(j) as (select 1 union select 2 union select 3), b(i) as (select 2 union select 3) select (3,4) in (select a.j, b.i+1 from a, b where a.j = b.i) as k group by k having k = 1;
}
expect unordered {
    1
}

@setup s1
test l9505 {
    With recursive a(x) as (select 1 union select 2 union select x in (select t1.i from mytable t1) from a) select x from a;
}
expect unordered {
    1
    2
}

