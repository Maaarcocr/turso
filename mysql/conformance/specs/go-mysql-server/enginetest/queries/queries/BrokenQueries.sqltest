    SELECT 1 FROM DUAL WHERE (1, null) in ((1, null));
}
expect unordered {
}

test l9523 {
    SELECT 1 FROM DUAL WHERE (0, null) = (0, null);
}
expect unordered {
}

test l9527 {
    SELECT 1 FROM DUAL WHERE (null, null) = (select null, null from dual);
}
expect unordered {
}

test l9571 {
    SELECT STR_TO_DATE('2013 32 Tuesday', '%X %V %W');
}
expect unordered {
    2013-08-13
}

test l9576 {
    SELECT STR_TO_DATE('01,5,2013 09:30:17','%d,%m,%Y %h:%i:%s %f') - (STR_TO_DATE('01,5,2013 09:30:17','%d,%m,%Y %h:%i:%s') - INTERVAL 1 SECOND);
}
expect unordered {
    1.000000
}

@setup s1
test l9583 {
    WITH RECURSIVE cte(i, j) AS (
    SELECT 0, 1, 2
    FROM mytable

    UNION ALL
    
    SELECT *
    FROM mytable, cte
    WHERE cte.i = mytable.i   
)
SELECT *
FROM mytable;
}
expect unordered {
    1|first row
    2|second row
    3|third row
}

test l9609 {
    SELECT json_type(cast(cast('2001-01-01 12:34:56.123456' as time) as json));
}
expect unordered {
    TIME
}

test l9616 {
    SELECT json_type(cast(cast('123abc' as binary) as json));
}
expect unordered {
    BLOB
}

test l9623 {
    SELECT json_type(json_extract('\{"a": 1e2\}', '$.a'));
}
expect unordered {
    DOUBLE
}

test l9630 {
    SELECT json_type(json_extract(json_object("a", cast(10 as double)), "$.a"));
}
expect unordered {
    DOUBLE
}

test l9636 {
    SELECT json_type(json_extract(json_object("a", cast(10 as unsigned)), "$.a"));
}
expect unordered {
    UNSIGNED INTEGER
}

test l9642 {
    SELECT json_type(json_extract(json_object("a", cast(10 as signed)), "$.a"));
}
expect unordered {
    INTEGER
}

test l9648 {
    SELECT json_type(json_extract(json_object("a", cast(10 as decimal)), "$.a"));
}
expect unordered {
    DECIMAL
}
