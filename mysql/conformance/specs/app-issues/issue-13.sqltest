# Specs from https://github.com/Maaarcocr/turso/issues/13: INSERT IGNORE is refused
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, v INT);
}

setup p2 {
    INSERT INTO t1 VALUES (1, 10);
}

setup p3 {
    INSERT IGNORE INTO t1 VALUES (1, 99), (2, 20);
}

@setup p1
@setup p2
test s3 {
    INSERT IGNORE INTO t1 VALUES (1, 99), (2, 20);
}
expect {
}

@setup p1
@setup p2
@setup p3
test s4 {
    SELECT id, v FROM t1 ORDER BY id;
}
expect {
    1|10
    2|20
}
