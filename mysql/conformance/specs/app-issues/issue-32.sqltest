# Specs from https://github.com/Maaarcocr/turso/issues/32: GROUP_CONCAT(... ORDER BY ...) is refused
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, g INT);
}

setup p2 {
    INSERT INTO t1 VALUES (1, 1), (2, 1), (3, 2);
}

@setup p1
@setup p2
test s3 {
    SELECT g, GROUP_CONCAT(id ORDER BY id DESC SEPARATOR ',') FROM t1 GROUP BY g ORDER BY g;
}
expect {
    1|2,1
    2|3
}
