# Specs from https://github.com/Maaarcocr/turso/issues/5: utf8mb4_general_ci and utf8mb4_unicode_ci are refused (tables, COLLATE, SET NAMES)
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, nm VARCHAR(20) COLLATE utf8mb4_general_ci) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
}

setup p2 {
    INSERT INTO t1 VALUES (1, 'abc');
}

setup p5 {
    SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;
}

test s1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, nm VARCHAR(20) COLLATE utf8mb4_general_ci) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
}
expect {
}

@setup p1
test s2 {
    INSERT INTO t1 VALUES (1, 'abc');
}
expect {
}

@setup p1
@setup p2
test s3 {
    SELECT COUNT(*) FROM t1 WHERE nm = 'ABC  ';
}
expect {
    1
}

@setup p1
@setup p2
test s4 {
    SELECT 'a' = 'a ' COLLATE utf8mb4_general_ci AS pad_space, 'a' = 'a ' COLLATE utf8mb4_0900_ai_ci AS no_pad;
}
expect {
    1|0
}

@setup p1
@setup p2
test s5 {
    SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;
}
expect {
}
