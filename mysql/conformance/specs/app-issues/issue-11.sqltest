# Specs from https://github.com/Maaarcocr/turso/issues/11: DEFAULT CURRENT_TIMESTAMP(6) (fractional seconds) is refused
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, ts1 DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6));
}

setup p2 {
    CREATE TABLE t2 (id BIGINT PRIMARY KEY, ts2 DATETIME(3) DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3));
}

setup p3 {
    INSERT INTO t1 (id) VALUES (1);
}

test s1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, ts1 DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6));
}
expect {
}

@setup p1
test s2 {
    CREATE TABLE t2 (id BIGINT PRIMARY KEY, ts2 DATETIME(3) DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3));
}
expect {
}

@setup p1
@setup p2
test s3 {
    INSERT INTO t1 (id) VALUES (1);
}
expect {
}

@setup p1
@setup p2
@setup p3
test s4 {
    SELECT LENGTH(ts1) FROM t1;
}
expect {
    26
}
