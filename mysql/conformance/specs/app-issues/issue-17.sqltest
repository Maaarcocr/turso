# Specs from https://github.com/Maaarcocr/turso/issues/17: CAST(x AS CHAR CHARACTER SET ascii) is a parse error
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, nm VARCHAR(20));
}

setup p2 {
    INSERT INTO t1 VALUES (1, 'héllo');
}

@setup p1
@setup p2
test s3 {
    SELECT CAST(HEX(nm) AS CHAR CHARACTER SET ascii) FROM t1;
}
expect {
    68C3A96C6C6F
}

@setup p1
@setup p2
test s4 {
    SELECT CAST('abc' AS CHAR CHARACTER SET utf8mb4);
}
expect {
    abc
}

@setup p1
@setup p2
test s5 {
    SELECT CONVERT(nm USING ascii) FROM t1;
}
expect {
    h?llo
}
