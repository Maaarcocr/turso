# Specs from https://github.com/Maaarcocr/turso/issues/18: Named locks (GET_LOCK, RELEASE_LOCK, RELEASE_ALL_LOCKS, IS_FREE_LOCK) are missing
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    SELECT GET_LOCK('my_lock', 0);
}

setup p2 {
    SELECT IS_FREE_LOCK('my_lock');
}

setup p3 {
    SELECT RELEASE_LOCK('my_lock');
}

setup p4 {
    SELECT RELEASE_ALL_LOCKS();
}

test s1 {
    SELECT GET_LOCK('my_lock', 0);
}
expect {
    1
}

@setup p1
test s2 {
    SELECT IS_FREE_LOCK('my_lock');
}
expect {
    0
}

@setup p1
@setup p2
test s3 {
    SELECT RELEASE_LOCK('my_lock');
}
expect {
    1
}

@setup p1
@setup p2
@setup p3
test s4 {
    SELECT RELEASE_ALL_LOCKS();
}
expect {
    0
}
