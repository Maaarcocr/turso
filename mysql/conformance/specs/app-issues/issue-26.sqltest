# Specs from https://github.com/Maaarcocr/turso/issues/26: A JSON column returns the text as inserted; MySQL returns its normalized form
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t7 (id BIGINT PRIMARY KEY, j JSON);
}

setup p2 {
    INSERT INTO t7 VALUES (1, '\{"b":2,  "a":[1,2], "aa": true\}');
}

@setup p1
@setup p2
test s3 {
    SELECT j FROM t7;
}
expect {
    \{"a": [1, 2], "b": 2, "aa": true\}
}

@setup p1
@setup p2
test s4 {
    SELECT JSON_EXTRACT(j, '$.a') FROM t7;
}
expect {
    [1, 2]
}

@setup p1
@setup p2
test s5 {
    SELECT j = CAST('\{"a": [1, 2], "b": 2, "aa": true\}' AS JSON) FROM t7;
}
expect {
    1
}
