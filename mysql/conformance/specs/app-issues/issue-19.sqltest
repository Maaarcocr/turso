# Specs from https://github.com/Maaarcocr/turso/issues/19: JSON_ARRAYAGG and JSON_OBJECTAGG are missing
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE p1 (id BIGINT PRIMARY KEY, nm VARCHAR(20));
}

setup p2 {
    CREATE TABLE c1 (id BIGINT PRIMARY KEY, p_id BIGINT, lbl VARCHAR(20));
}

setup p3 {
    INSERT INTO p1 VALUES (1, 'first'), (2, 'second');
}

setup p4 {
    INSERT INTO c1 VALUES (10, 1, 'x'), (11, 1, 'y'), (12, 2, 'z');
}

@setup p1
@setup p2
@setup p3
@setup p4
test s5 {
    SELECT p.id, JSON_ARRAYAGG(c.id) AS ids FROM p1 p JOIN c1 c ON c.p_id = p.id GROUP BY p.id ORDER BY p.id;
}
expect {
    1|[10, 11]
    2|[12]
}

@setup p1
@setup p2
@setup p3
@setup p4
test s6 {
    SELECT JSON_OBJECTAGG(lbl, id) FROM c1;
}
expect {
    \{"x": 10, "y": 11, "z": 12\}
}
