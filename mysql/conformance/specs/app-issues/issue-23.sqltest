# Specs from https://github.com/Maaarcocr/turso/issues/23: Row order without ORDER BY differs from InnoDB (covering secondary index and joins)
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, nm VARCHAR(20) NOT NULL, KEY k_nm (nm));
}

setup p2 {
    INSERT INTO t1 VALUES (1, 'pear'), (2, 'apple'), (3, 'fig'), (4, 'banana');
}

setup p3 {
    CREATE TABLE t3 (id BIGINT PRIMARY KEY, lbl VARCHAR(20), KEY k_lbl (lbl));
}

setup p4 {
    CREATE TABLE t4 (a_id BIGINT, b_id BIGINT, PRIMARY KEY (a_id, b_id), KEY k_b (b_id));
}

setup p5 {
    INSERT INTO t3 VALUES (1, 'z'), (2, 'a');
}

setup p6 {
    INSERT INTO t4 VALUES (1, 2), (2, 1), (3, 2), (4, 1);
}

@setup p1
@setup p2
@setup p3
@setup p4
@setup p5
@setup p6
test s7 {
    SELECT id, nm FROM t1;
}
expect {
    2|apple
    4|banana
    3|fig
    1|pear
}

@setup p1
@setup p2
@setup p3
@setup p4
@setup p5
@setup p6
test s8 {
    SELECT id FROM t1;
}
expect {
    2
    4
    3
    1
}

@setup p1
@setup p2
@setup p3
@setup p4
@setup p5
@setup p6
test s9 {
    SELECT x.lbl FROM t4 y JOIN t3 x ON x.id = y.b_id WHERE y.a_id IN (1, 2, 3, 4);
}
expect {
    a
    a
    z
    z
}
