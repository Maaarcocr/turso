# Specs from https://github.com/Maaarcocr/turso/issues/16: DATABASE(), VERSION(), CONNECTION_ID(), LAST_INSERT_ID(), ROW_COUNT(), FOUND_ROWS() are missing
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, v INT);
}

setup p2 {
    INSERT INTO t1 (v) VALUES (10), (20);
}

setup p3 {
    SELECT LAST_INSERT_ID();
}

setup p4 {
    SELECT ROW_COUNT();
}

setup p5 {
    SELECT DATABASE() IS NOT NULL;
}

setup p6 {
    SELECT VERSION() LIKE '8.%';
}

setup p7 {
    SELECT CONNECTION_ID() > 0;
}

setup p8 {
    SELECT SQL_CALC_FOUND_ROWS id FROM t1 LIMIT 1;
}

setup p9 {
    SELECT FOUND_ROWS();
}

@setup p1
@setup p2
test s3 {
    SELECT LAST_INSERT_ID();
}
expect {
    1
}

@setup p1
@setup p2
@setup p3
test s4 {
    SELECT ROW_COUNT();
}
expect {
    -1
}

@setup p1
@setup p2
@setup p3
@setup p4
test s5 {
    SELECT DATABASE() IS NOT NULL;
}
expect {
    1
}

@setup p1
@setup p2
@setup p3
@setup p4
@setup p5
test s6 {
    SELECT VERSION() LIKE '8.%';
}
expect {
    1
}

@setup p1
@setup p2
@setup p3
@setup p4
@setup p5
@setup p6
test s7 {
    SELECT CONNECTION_ID() > 0;
}
expect {
    1
}

@setup p1
@setup p2
@setup p3
@setup p4
@setup p5
@setup p6
@setup p7
test s8 {
    SELECT SQL_CALC_FOUND_ROWS id FROM t1 LIMIT 1;
}
expect {
    1
}

@setup p1
@setup p2
@setup p3
@setup p4
@setup p5
@setup p6
@setup p7
@setup p8
test s9 {
    SELECT FOUND_ROWS();
}
expect {
    1
}
