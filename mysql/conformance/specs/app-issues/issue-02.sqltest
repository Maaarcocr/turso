# Specs from https://github.com/Maaarcocr/turso/issues/2: Index hints (USE INDEX, FORCE INDEX, IGNORE INDEX) make the statement fail
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, a INT, b INT, KEY idx_a (a), KEY idx_ab (a, b));
}

setup p2 {
    INSERT INTO t1 VALUES (1, 10, 100), (2, 20, 200), (3, 10, 300);
}

@setup p1
@setup p2
test s3 {
    SELECT id FROM t1 USE INDEX (idx_a) WHERE a = 10 ORDER BY id;
}
expect {
    1
    3
}

@setup p1
@setup p2
test s4 {
    SELECT id FROM t1 FORCE INDEX (idx_ab) WHERE a = 10 ORDER BY id;
}
expect {
    1
    3
}

@setup p1
@setup p2
test s5 {
    SELECT id FROM t1 IGNORE INDEX (PRIMARY) WHERE a = 10 ORDER BY id;
}
expect {
    1
    3
}

@setup p1
@setup p2
test s6 {
    SELECT i.id FROM t1 AS i USE INDEX (idx_a) WHERE i.a = 20;
}
expect {
    2
}
