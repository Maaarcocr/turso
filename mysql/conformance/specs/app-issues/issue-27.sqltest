# Specs from https://github.com/Maaarcocr/turso/issues/27: Arithmetic on a BIGINT UNSIGNED column above 2^63-1 returns a double
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE u (id BIGINT PRIMARY KEY, x BIGINT UNSIGNED);
}

setup p2 {
    INSERT INTO u VALUES (1, 18446744073709551615), (2, 9223372036854775808);
}

@setup p1
@setup p2
test s3 {
    SELECT id, x, x - 1, x + 0, x DIV 2 FROM u ORDER BY id;
}
expect {
    1|18446744073709551615|18446744073709551614|18446744073709551615|9223372036854775807
    2|9223372036854775808|9223372036854775807|9223372036854775808|4611686018427387904
}
