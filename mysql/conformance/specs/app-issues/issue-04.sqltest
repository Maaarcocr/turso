# Specs from https://github.com/Maaarcocr/turso/issues/4: Reading system variables (@@sql_mode) and the common driver session SET are refused
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p3 {
    SET sql_mode=(SELECT CONCAT(@@sql_mode, ',PIPES_AS_CONCAT,NO_ENGINE_SUBSTITUTION')),time_zone='+00:00',NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;
}

setup p4 {
    SET SESSION sql_mode = 'STRICT_ALL_TABLES';
}

test s1 {
    SELECT @@sql_mode;
}
expect {
    ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
}

test s2 {
    SELECT @@session.time_zone, @@transaction_isolation;
}
expect {
    +00:00|REPEATABLE-READ
}

test s3 {
    SET sql_mode=(SELECT CONCAT(@@sql_mode, ',PIPES_AS_CONCAT,NO_ENGINE_SUBSTITUTION')),time_zone='+00:00',NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;
}
expect {
}

@setup p3
test s4 {
    SET SESSION sql_mode = 'STRICT_ALL_TABLES';
}
expect {
}
