# Specs from https://github.com/Maaarcocr/turso/issues/29: STORED generated columns are refused
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE g1 (id BIGINT PRIMARY KEY, a INT, b INT GENERATED ALWAYS AS (a * 2) STORED);
}

setup p2 {
    CREATE TABLE g2 (id BIGINT PRIMARY KEY, a INT, b INT GENERATED ALWAYS AS (a * 2) VIRTUAL);
}

setup p3 {
    INSERT INTO g2 (id, a) VALUES (1, 21);
}

test s1 {
    CREATE TABLE g1 (id BIGINT PRIMARY KEY, a INT, b INT GENERATED ALWAYS AS (a * 2) STORED);
}
expect {
}

@setup p1
test s2 {
    CREATE TABLE g2 (id BIGINT PRIMARY KEY, a INT, b INT GENERATED ALWAYS AS (a * 2) VIRTUAL);
}
expect {
}

@setup p1
@setup p2
test s3 {
    INSERT INTO g2 (id, a) VALUES (1, 21);
}
expect {
}

@setup p1
@setup p2
@setup p3
test s4 {
    SELECT b FROM g2;
}
expect {
    42
}
