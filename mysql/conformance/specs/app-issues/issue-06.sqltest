# Specs from https://github.com/Maaarcocr/turso/issues/6: Tables and columns with CHARACTER SET utf8 (utf8mb3) are refused
# Expected values are MySQL 8.4.8's (Percona Server 8.4.8-8, default 8.4
# profile, time_zone '+00:00') as reported in the issue; they were not
# recorded by tools/record_mysql.py. One test per statement MySQL answered;
# every earlier statement that MySQL ran without error is a setup.
@database :memory:

setup p1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, s1 VARCHAR(10) CHARACTER SET utf8 COLLATE utf8_general_ci) DEFAULT CHARSET=utf8mb4;
}

setup p2 {
    CREATE TABLE t2 (id BIGINT PRIMARY KEY, s1 VARCHAR(10)) DEFAULT CHARSET=utf8;
}

test s1 {
    CREATE TABLE t1 (id BIGINT PRIMARY KEY, s1 VARCHAR(10) CHARACTER SET utf8 COLLATE utf8_general_ci) DEFAULT CHARSET=utf8mb4;
}
expect {
}

@setup p1
test s2 {
    CREATE TABLE t2 (id BIGINT PRIMARY KEY, s1 VARCHAR(10)) DEFAULT CHARSET=utf8;
}
expect {
}
