    SELECT pk, col0 FROM tab3 WHERE ((col0 <= 67 OR ((col3 > 1 OR ((col1 IS NULL AND col3 IN (43,75,13,54,37)) OR (col4 > 26.19) AND col3 <= 26 AND (((col3 IS NULL)))) OR col0 >= 43 OR col0 = 32 AND ((col4 BETWEEN 39.3 AND 22.4 AND col4 IS NULL) OR col0 > 39) AND col3 <= 34) AND col0 IN (41,8,29,13,35) OR (((col3 > 70)) OR col3 = 87 AND (col3 >= 71 OR ((col0 <= 4 OR (col1 = 6.28) AND col0 < 41)) AND (col4 >= 49.93 AND col3 < 45 OR ((col3 IS NULL)) AND col3 <= 20 OR (col3 > 73)) AND col0 < 31) OR (col0 >= 5 AND (col1 > 97.98) AND col3 > 85)) AND col1 < 56.95 AND ((col1 > 85.66)) AND col0 < 43 OR (col3 > 22 OR (col0 < 39)) OR (col3 > 85))) AND col0 >= 97 OR (col1 < 2.82)) ORDER BY 2 DESC,1;
}
expect {
    9|410
    8|406
    7|404
    6|403
    5|402
    4|401
    3|400
    2|397
    1|396
    0|393
}

