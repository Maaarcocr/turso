    SELECT pk, col0 FROM tab0 WHERE col0 > 41 OR col1 < 49.4 AND (col4 > 14.84) OR col0 < 85 AND col4 <= 96.80 AND col4 > 65.9 AND ((((col3 < 27 AND col1 IS NULL AND col3 = 79)))) ORDER BY 1 DESC;
}
expect {
    9|392
    8|389
    7|388
    6|387
    5|385
    4|384
    3|383
    2|382
    1|381
    0|380
}

