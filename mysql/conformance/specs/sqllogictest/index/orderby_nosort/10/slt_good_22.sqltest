    INSERT INTO tab0 VALUES(6,387,402.99,'tgzht',391,382.18,'hagvt');
    INSERT INTO tab0 VALUES(7,388,411.47,'lfbuj',392,385.30,'jfbrk');
    INSERT INTO tab0 VALUES(8,389,414.58,'wwonk',395,386.8,'hacsa');
    INSERT INTO tab0 VALUES(9,392,417.95,'zhdzu',396,387.36,'jryvi');
    CREATE TABLE tab1(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab1_0 on tab1 (col0);
    CREATE INDEX idx_tab1_1 on tab1 (col1);
    CREATE INDEX idx_tab1_3 on tab1 (col3);
    CREATE INDEX idx_tab1_4 on tab1 (col4);
    INSERT INTO tab1 SELECT * FROM tab0;
    CREATE TABLE tab2(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab2_0 ON tab2 (col3,col4 DESC);
    CREATE INDEX idx_tab2_1 ON tab2 (col4,col1);
    CREATE INDEX idx_tab2_3 ON tab2 (col1);
    CREATE UNIQUE INDEX idx_tab2_5 ON tab2 (col4 DESC,col0 DESC,col3 DESC);
    INSERT INTO tab2 SELECT * FROM tab0;
    CREATE TABLE tab3(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab3_0 ON tab3 (col3,col4);
    CREATE INDEX idx_tab3_1 ON tab3 (col4,col1 DESC);
    CREATE UNIQUE INDEX idx_tab3_2 ON tab3 (col0 DESC);
    CREATE INDEX idx_tab3_3 ON tab3 (col3,col1);
    INSERT INTO tab3 SELECT * FROM tab0;
    CREATE TABLE tab4(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab4_0 ON tab4 (col0,col3);
    CREATE UNIQUE INDEX idx_tab4_1 ON tab4 (col1,col4 DESC);
    CREATE UNIQUE INDEX idx_tab4_3 ON tab4 (col1 DESC,col3);
    INSERT INTO tab4 SELECT * FROM tab0;
}

