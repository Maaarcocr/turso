setup s1 {
    CREATE TABLE tab0(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    INSERT INTO tab0 VALUES(0,380,388.20,'aaccq',385,375.64,'fdabt');
    INSERT INTO tab0 VALUES(1,381,389.43,'yaiqu',386,377.66,'wxitw');
    INSERT INTO tab0 VALUES(2,382,390.91,'gtrae',387,378.14,'megfv');
    INSERT INTO tab0 VALUES(3,383,392.71,'ronst',388,379.51,'rksly');
