    CREATE INDEX idx_tab2_1 ON tab2 (col0 DESC,col4);
    INSERT INTO tab2 SELECT * FROM tab0;
    DROP TABLE tab3;
    CREATE TABLE tab3(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab3_0 ON tab3 (col4);
    CREATE UNIQUE INDEX idx_tab3_1 ON tab3 (col3);
    CREATE UNIQUE INDEX idx_tab3_5 ON tab3 (col1 DESC);
    INSERT INTO tab3 SELECT * FROM tab0;
    DROP TABLE tab4;
    CREATE TABLE tab4(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab4_0 ON tab4 (col4 DESC);
    INSERT INTO tab4 SELECT * FROM tab0;
    DELETE FROM tab0 WHERE ((col3 > 5 AND col0 > 2));
    DELETE FROM tab1 WHERE ((col3 > 5 AND col0 > 2));
    DELETE FROM tab2 WHERE ((col3 > 5 AND col0 > 2));
    DELETE FROM tab3 WHERE ((col3 > 5 AND col0 > 2));
    DELETE FROM tab4 WHERE ((col3 > 5 AND col0 > 2));
    DELETE FROM tab0 WHERE col1 = 4.63 AND col0 >= 4 OR col1 <= 8.84;
    DELETE FROM tab1 WHERE col1 = 4.63 AND col0 >= 4 OR col1 <= 8.84;
}

