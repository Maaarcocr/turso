    SELECT pk, col0 FROM tab1 WHERE (col0 >= 399 OR (col4 >= 414.21 OR (col3 = 561) AND col0 >= 893 AND col1 > 301.97 AND ((col3 >= 896 OR col4 > 84.66 AND (((col3 = 183 AND (col1 > 313.73) AND col0 = 340 AND col4 > 393.69))) AND col4 > 749.98) AND col1 >= 700.54) AND col0 <= 292 AND ((col0 < 300 AND ((col0 IN (886,948,315) AND col0 >= 363 OR ((col0 >= 0 OR (col0 > 908 AND (col3 <= 472))) AND col3 = 146) AND (col4 < 957.28 AND col1 >= 343.80) AND (((col3 IS NULL))) OR col0 < 993 AND (col3 > 145 AND col0 > 715))) AND col3 > 23 AND col3 > 119 OR col1 >= 504.37 OR col0 <= 982 OR col0 < 807)) AND col3 > 359 AND (((col4 IN (720.65,967.65,637.53,15.35) AND col3 < 405))) AND (col4 >= 589.67) OR col3 >= 404 OR (col3 >= 629) OR col0 <= 849 OR col0 > 304 AND (col3 >= 621) OR col1 < 7.76)) ORDER BY 1 DESC;
}
expect unordered {
    0|508
