    SELECT pk, col0 FROM tab2 WHERE col4 = 459.91 AND col0 <= 88 AND (col3 >= 262) OR (((col4 > 164.86)) AND col0 < 653 AND col0 = 394 OR col4 >= 747.91) OR col3 > 673 OR col3 > 357 OR col3 >= 844 OR col4 IS NULL AND col3 > 922 AND ((((((col4 < 127.80))))) AND col3 > 287 AND col1 <= 505.77) AND col0 > 418 OR col0 >= 671 AND (col3 >= 183) ORDER BY 2;
}
expect unordered {
    0|591
    1|435
    3|540
    4|747
    6|252
    7|554
    9|998
}

