setup s1 {
    CREATE TABLE tab0(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    INSERT INTO tab0 VALUES(0,203,160.53,'qiaaz',289,804.36,'nrpmw');
    INSERT INTO tab0 VALUES(1,903,732.84,'nntch',352,205.67,'eooaq');
    INSERT INTO tab0 VALUES(2,150,978.68,'qdonr',167,867.15,'yquyn');
