@database :memory:

setup s1 {
    CREATE TABLE tab0(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    INSERT INTO tab0 VALUES(0,183,932.73,'ouinp',780,92.61,'ftzrk');
    INSERT INTO tab0 VALUES(1,583,212.98,'xjias',630,112.62,'poprc');
    INSERT INTO tab0 VALUES(2,438,285.89,'rwhao',906,216.81,'rzorg');
    INSERT INTO tab0 VALUES(3,326,322.22,'tgryo',538,517.10,'vnrbg');
    INSERT INTO tab0 VALUES(4,188,408.99,'gucqv',131,106.52,'ehzlv');
    INSERT INTO tab0 VALUES(5,948,671.10,'oppzl',590,178.75,'urxjc');
    INSERT INTO tab0 VALUES(6,146,406.96,'sjomk',741,157.80,'uukvv');
    INSERT INTO tab0 VALUES(7,554,197.8,'gxyzy',961,821.63,'mgavm');
    INSERT INTO tab0 VALUES(8,808,45.75,'nuldp',800,424.74,'mtcej');
    INSERT INTO tab0 VALUES(9,29,491.62,'qyqhg',608,825.85,'wswzt');
    CREATE TABLE tab1(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab1_0 on tab1 (col0);
    CREATE INDEX idx_tab1_1 on tab1 (col1);
    CREATE INDEX idx_tab1_3 on tab1 (col3);
    CREATE INDEX idx_tab1_4 on tab1 (col4);
    INSERT INTO tab1 SELECT * FROM tab0;
    CREATE TABLE tab2(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab2_0 ON tab2 (col4);
    CREATE INDEX idx_tab2_2 ON tab2 (col3);
    INSERT INTO tab2 SELECT * FROM tab0;
    CREATE TABLE tab3(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab3_0 ON tab3 (col3 DESC,col0);
    CREATE UNIQUE INDEX idx_tab3_1 ON tab3 (col4);
    CREATE UNIQUE INDEX idx_tab3_3 ON tab3 (col1);
    INSERT INTO tab3 SELECT * FROM tab0;
    CREATE TABLE tab4(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab4_0 ON tab4 (col0 DESC);
    CREATE INDEX idx_tab4_1 ON tab4 (col1,col4 DESC);
    CREATE INDEX idx_tab4_2 ON tab4 (col3);
    INSERT INTO tab4 SELECT * FROM tab0;
}

