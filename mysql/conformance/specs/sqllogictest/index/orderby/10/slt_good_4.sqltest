@database :memory:

setup s1 {
    CREATE TABLE tab0(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    INSERT INTO tab0 VALUES(0,683,546.7,'yfzcy',167,802.12,'ntagf');
    INSERT INTO tab0 VALUES(1,646,587.66,'lfjsk',165,50.41,'glrnm');
    INSERT INTO tab0 VALUES(2,187,712.5,'zqxmi',473,825.24,'nrvcq');
    INSERT INTO tab0 VALUES(3,587,861.7,'avtww',19,128.26,'kdxce');
    INSERT INTO tab0 VALUES(4,948,506.95,'xrktw',613,310.8,'bcemo');
    INSERT INTO tab0 VALUES(5,321,279.46,'jybpp',76,690.40,'lrtku');
    INSERT INTO tab0 VALUES(6,829,594.2,'edknc',362,182.13,'wwvhi');
    INSERT INTO tab0 VALUES(7,790,273.80,'vtele',687,923.51,'qrnwj');
    INSERT INTO tab0 VALUES(8,846,171.91,'blugt',651,895.26,'pknjs');
    INSERT INTO tab0 VALUES(9,87,803.46,'ozawp',364,549.68,'ynosg');
    CREATE TABLE tab1(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab1_0 on tab1 (col0);
    CREATE INDEX idx_tab1_1 on tab1 (col1);
    CREATE INDEX idx_tab1_3 on tab1 (col3);
    CREATE INDEX idx_tab1_4 on tab1 (col4);
    INSERT INTO tab1 SELECT * FROM tab0;
    CREATE TABLE tab2(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab2_0 ON tab2 (col3 DESC);
    CREATE UNIQUE INDEX idx_tab2_2 ON tab2 (col4,col1 DESC);
    CREATE INDEX idx_tab2_4 ON tab2 (col0);
    INSERT INTO tab2 SELECT * FROM tab0;
    CREATE TABLE tab3(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab3_1 ON tab3 (col3,col1);
    CREATE UNIQUE INDEX idx_tab3_2 ON tab3 (col3 DESC,col0 DESC);
    CREATE INDEX idx_tab3_4 ON tab3 (col4 DESC,col1 DESC);
    INSERT INTO tab3 SELECT * FROM tab0;
    CREATE TABLE tab4(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab4_0 ON tab4 (col3,col4,col0 DESC);
    CREATE INDEX idx_tab4_1 ON tab4 (col0,col3 DESC);
    CREATE UNIQUE INDEX idx_tab4_4 ON tab4 (col1 DESC);
    INSERT INTO tab4 SELECT * FROM tab0;
}

