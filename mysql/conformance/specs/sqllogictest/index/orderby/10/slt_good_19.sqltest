setup s1 {
    CREATE TABLE tab0(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    INSERT INTO tab0 VALUES(0,975,910.48,'zewnh',208,29.88,'xaddy');
    INSERT INTO tab0 VALUES(1,957,930.7,'roryv',438,893.41,'ohbap');
    INSERT INTO tab0 VALUES(2,100,624.66,'ubwnz',519,567.93,'npcpr');
