    SELECT pk, col0 FROM tab3 WHERE col0 <= 214 OR col4 >= 347.17 OR ((col4 > 896.84) OR ((col3 IN (208) AND (col0 = 513 AND (col1 > 316.23)) OR (col1 < 842.26 OR col0 = 527)) AND col0 < 136) AND col1 > 864.68) AND (col0 < 550) AND ((col0 IN (SELECT col3 FROM tab3 WHERE col0 > 188))) AND ((col3 > 226)) ORDER BY 2,1;
}
expect unordered {
    1|957
    2|100
    3|419
    4|293
    5|85
    6|769
    7|558
    8|523
}

