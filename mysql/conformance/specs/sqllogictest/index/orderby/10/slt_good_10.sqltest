@database :memory:

setup s1 {
    CREATE TABLE tab0(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    INSERT INTO tab0 VALUES(0,486,512.97,'oqfla',717,927.45,'ukifd');
    INSERT INTO tab0 VALUES(1,389,774.50,'iftrt',580,833.72,'plyul');
    INSERT INTO tab0 VALUES(2,691,54.83,'ruohf',675,839.81,'bnrri');
    INSERT INTO tab0 VALUES(3,409,958.17,'uyiss',175,79.35,'gxave');
    INSERT INTO tab0 VALUES(4,280,930.22,'omqte',787,87.76,'txzae');
    INSERT INTO tab0 VALUES(5,387,378.80,'khbeq',378,923.91,'yvzhq');
    INSERT INTO tab0 VALUES(6,785,795.44,'pwild',595,299.68,'ahgqw');
    INSERT INTO tab0 VALUES(7,122,889.7,'ixiiw',495,700.65,'datqo');
    INSERT INTO tab0 VALUES(8,269,707.56,'vcjjl',168,512.69,'qljdr');
    INSERT INTO tab0 VALUES(9,943,755.44,'lmhuw',363,147.61,'zictu');
    CREATE TABLE tab1(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab1_0 on tab1 (col0);
    CREATE INDEX idx_tab1_1 on tab1 (col1);
    CREATE INDEX idx_tab1_3 on tab1 (col3);
    CREATE INDEX idx_tab1_4 on tab1 (col4);
    INSERT INTO tab1 SELECT * FROM tab0;
    CREATE TABLE tab2(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab2_0 ON tab2 (col0,col1,col4);
    CREATE UNIQUE INDEX idx_tab2_1 ON tab2 (col1,col0 DESC);
    CREATE UNIQUE INDEX idx_tab2_2 ON tab2 (col3);
    INSERT INTO tab2 SELECT * FROM tab0;
    CREATE TABLE tab3(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab3_0 ON tab3 (col1 DESC,col4);
    CREATE INDEX idx_tab3_1 ON tab3 (col3);
    INSERT INTO tab3 SELECT * FROM tab0;
    CREATE TABLE tab4(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab4_0 ON tab4 (col4 DESC);
    CREATE INDEX idx_tab4_3 ON tab4 (col0 DESC,col1 DESC,col3);
    CREATE INDEX idx_tab4_5 ON tab4 (col1);
    INSERT INTO tab4 SELECT * FROM tab0;
}

