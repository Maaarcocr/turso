setup s1 {
    CREATE TABLE tab0(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    INSERT INTO tab0 VALUES(0,555,199.73,'gdeya',289,489.32,'jnref');
    INSERT INTO tab0 VALUES(1,14,600.17,'bcuug',237,908.49,'wcwgy');
