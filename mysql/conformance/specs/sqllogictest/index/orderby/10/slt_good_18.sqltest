    INSERT INTO tab0 VALUES(9,929,138.53,'rpipu',973,688.0,'iynmh');
    CREATE TABLE tab1(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab1_0 on tab1 (col0);
    CREATE INDEX idx_tab1_1 on tab1 (col1);
    CREATE INDEX idx_tab1_3 on tab1 (col3);
    CREATE INDEX idx_tab1_4 on tab1 (col4);
    INSERT INTO tab1 SELECT * FROM tab0;
    CREATE TABLE tab2(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab2_0 ON tab2 (col1 DESC);
    CREATE UNIQUE INDEX idx_tab2_1 ON tab2 (col3,col4 DESC);
    CREATE UNIQUE INDEX idx_tab2_3 ON tab2 (col4 DESC,col0);
    CREATE UNIQUE INDEX idx_tab2_5 ON tab2 (col0 DESC);
    INSERT INTO tab2 SELECT * FROM tab0;
    CREATE TABLE tab3(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE INDEX idx_tab3_0 ON tab3 (col3,col1 DESC);
    CREATE UNIQUE INDEX idx_tab3_2 ON tab3 (col1 DESC,col0 DESC);
    CREATE UNIQUE INDEX idx_tab3_3 ON tab3 (col0 DESC,col4);
    CREATE UNIQUE INDEX idx_tab3_5 ON tab3 (col0,col3);
    INSERT INTO tab3 SELECT * FROM tab0;
    CREATE TABLE tab4(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT);
    CREATE UNIQUE INDEX idx_tab4_0 ON tab4 (col3 DESC,col0,col1);
    CREATE UNIQUE INDEX idx_tab4_1 ON tab4 (col1);
    INSERT INTO tab4 SELECT * FROM tab0;
}

