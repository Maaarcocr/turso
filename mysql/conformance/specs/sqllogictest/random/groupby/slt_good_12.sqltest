    SELECT - 28 / - NULLIF ( - + AVG ( DISTINCT - col1 ), col1 ) FROM tab2 AS cor0 GROUP BY col1 HAVING NULL <= NULL;
}
expect unordered {
}

@setup s1
test l73493 {
    SELECT DISTINCT - 32 AS col1 FROM tab1 AS cor0 GROUP BY cor0.col2;
}
expect unordered {
    -32
}

