    SELECT DISTINCT - 79 FROM tab1 GROUP BY tab1.col0;
}
expect unordered {
    -79
}

@setup s1
test l65634 {
    SELECT DISTINCT - col0 AS col2 FROM tab2 cor0 GROUP BY col0, cor0.col2;
}
expect unordered {
    -15
    -91
    -92
}

@setup s1
test l65689 {
    SELECT cor0.col1 FROM tab0 AS cor0 GROUP BY cor0.col0, col1;
}
expect unordered {
    0
    0
    81
}

@setup s1
test l65772 {
    SELECT ALL - tab1.col2 * tab1.col2 FROM tab1 GROUP BY col2;
}
expect unordered {
    -2025
    -5041
    -64
}

# mysql-error: 1055 42000 Expression #1 of SELECT list is not in GROUP BY clause and contains nonaggregated column 'test.cor0.col1' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by
@setup s1
test l65863 {
    SELECT DISTINCT cor0.col2 * COALESCE ( + 40, col1 ) FROM tab2 AS cor0 GROUP BY cor0.col2;
}
expect error {
}

