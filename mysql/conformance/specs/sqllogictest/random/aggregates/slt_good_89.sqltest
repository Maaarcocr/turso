    SELECT SUM( ALL + - col0 ) * - - COUNT( * ) FROM tab1 AS cor0;
}
expect unordered {
    -681
}

@setup s1
test l90549 {
    SELECT ( - col2 ) + + + col0 + + col2 AS col0 FROM tab0;
}
expect unordered {
    15
    87
    97
}

@setup s1
test l91983 {
    SELECT DISTINCT + 26 AS col0 FROM tab2 AS cor0 WHERE col2 IS NOT NULL;
}
expect unordered {
    26
}
