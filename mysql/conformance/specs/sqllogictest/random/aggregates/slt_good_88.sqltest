    SELECT ALL + COUNT( * ) + + + COUNT( col2 ) AS col1 FROM tab0 WHERE NOT - col1 / + + 22 IS NULL;
}
expect unordered {
    6
}

@setup s1
test l89552 {
    SELECT DISTINCT + 92 * - + 72 AS col2, + 1 DIV - 12 + - - col1 + - + col2 AS col0 FROM tab2;
}
expect unordered {
    -6624|28
    -6624|37
    -6624|9
}

@setup s1
test l89680 {
    SELECT - COUNT( * ) DIV + COUNT( * ) + + COUNT( * ) col2 FROM tab1 AS cor0;
}
expect unordered {
    2
}

@setup s1
test l89953 {
    SELECT DISTINCT col2 + col1 AS col1 FROM tab2 AS cor0 WHERE - col1 NOT IN ( + ( col1 ) + col1 );
}
expect unordered {
    117
    125
    74
}

@setup s1
test l89980 {
    SELECT DISTINCT COUNT( * ) DIV + + SUM( ALL - + col1 ) AS col2 FROM tab0 AS cor0;
}
expect unordered {
    0
}
