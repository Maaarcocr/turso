    SELECT * FROM tab2 AS cor0 WHERE NOT 61 * + CAST( NULL AS SIGNED ) IN ( - CAST( 57 AS SIGNED ) * - + col2, - col2 );
}
expect unordered {
}

@setup s1
test l90160 {
    SELECT ALL - 1 + - col2 FROM tab2;
}
expect unordered {
    -24
    -41
    -59
}

@setup s1
test l90475 {
    SELECT 42 FROM tab1 WHERE NOT ( col0 ) > NULL;
}
expect unordered {
}

@setup s1
test l90775 {
    SELECT ALL 24 AS col0 FROM tab2 WHERE NOT ( NOT ( + 17 + + 47 > 63 ) );
}
expect unordered {
    24
    24
    24
}

@setup s1
test l90802 {
    SELECT - 78 * - 80 FROM tab1;
}
expect unordered {
    6240
    6240
    6240
}
