    SELECT + + col1 * + CAST( NULL AS SIGNED ) FROM tab1 cor0;
}
expect unordered {
    NULL
    NULL
    NULL
}

@setup s1
test l90067 {
    SELECT + col2 AS col2 FROM tab0 AS cor0 WHERE NULL IS NOT NULL;
}
expect unordered {
}

@setup s1
test l91127 {
    SELECT DISTINCT + ( + col1 ) AS col1 FROM tab0 WHERE NOT NULL NOT BETWEEN ( - CAST( NULL AS SIGNED ) ) AND NULL;
}
expect unordered {
}
