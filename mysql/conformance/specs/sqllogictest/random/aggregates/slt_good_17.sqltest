    SELECT + + ( + - 16 ) AS col1 FROM tab0 AS cor0;
}
expect unordered {
    -16
    -16
    -16
}

@setup s1
test l89819 {
    SELECT ALL + + 84, - SUM( - 11 ) AS col0 FROM tab0 AS cor0 WHERE col2 / + col0 IS NULL;
}
expect unordered {
    84|NULL
}

@setup s1
test l89833 {
    SELECT MAX( + + 62 ) AS col0 FROM tab1;
}
expect unordered {
    62
}

@setup s1
test l90236 {
    SELECT + MIN( + + CAST( NULL AS SIGNED ) ) AS col0 FROM tab2 AS cor0;
}
expect unordered {
    NULL
}

@setup s1
test l90643 {
    SELECT DISTINCT * FROM tab1 AS cor0 WHERE + col1 + + + 6 IS NOT NULL;
}
expect unordered {
    51|14|96
    85|5|59
    91|47|68
}

@setup s1
test l90870 {
    SELECT + COUNT( * ) + 0 FROM tab2 AS cor0;
}
expect unordered {
    3
}

@setup s1
test l91077 {
    SELECT ALL - col2 * + 22 FROM tab0;
}
expect unordered {
    -1034
    -2178
    -220
}

@setup s1
test l91084 {
    SELECT DISTINCT * FROM tab0 WHERE NOT + col1 * - col2 + col2 < ( NULL );
}
expect unordered {
}

@setup s1
test l91345 {
    SELECT col1 * + 6 FROM tab0;
}
expect unordered {
    126
    486
    6
}
