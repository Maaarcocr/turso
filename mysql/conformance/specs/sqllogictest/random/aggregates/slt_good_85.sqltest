    SELECT ALL + SUM( + 47 ) * + - COUNT( * ) * + - 78 * + 70, COUNT( * ) AS col0 FROM tab1;
}
expect unordered {
    2309580|3
}

@setup s1
test l89325 {
    SELECT DISTINCT + 25 - col2 FROM tab1;
}
expect unordered {
    -34
    -43
    -71
}

@setup s1
test l89408 {
    SELECT DISTINCT * FROM tab1 AS cor0 WHERE - col0 + - col2 < + col2;
}
expect unordered {
    51|14|96
    85|5|59
    91|47|68
}
