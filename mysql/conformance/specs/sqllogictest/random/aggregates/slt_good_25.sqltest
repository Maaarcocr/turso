    SELECT DISTINCT + col0 AS col0 FROM tab1 AS cor0 WHERE col0 IS NULL;
}
expect unordered {
}

@setup s1
test l91738 {
    SELECT + col0 * + + col1 + - col0 AS col1, + 82 AS col1 FROM tab1;
}
expect unordered {
    340|82
    4186|82
    663|82
}

@setup s1
test l91992 {
    SELECT ALL col1 + - col1 AS col2 FROM tab0 AS cor0 WHERE NOT NULL IS NOT NULL;
}
expect unordered {
    0
    0
    0
}

@setup s1
test l92205 {
    SELECT - ( - col1 ) - - ( - col2 ) + - + 99 AS col2, 97 col2 FROM tab0;
}
expect unordered {
    -197|97
    -65|97
    -88|97
}

@setup s1
test l92216 {
    SELECT ALL - ( col1 ) - - CAST( + col1 AS SIGNED ) - + col2 DIV - col1 AS col1 FROM tab1;
}
expect unordered {
    1
    11
    6
}

@setup s1
test l92282 {
    SELECT + ( CAST( NULL AS DECIMAL ) ) + col0 FROM tab1 AS cor0;
}
expect unordered {
    NULL
    NULL
    NULL
}

@setup s1
test l92314 {
    SELECT + MAX( ALL - ( + + col0 ) ) FROM tab0;
}
expect unordered {
    -15
}

@setup s1
test l92562 {
    SELECT 96 DIV 77 * - MIN( 38 ) FROM tab2;
}
expect unordered {
    -38
}

@setup s1
test l92787 {
    SELECT ALL - + 42 + col1 AS col0 FROM tab1 AS cor0;
}
expect unordered {
    -28
    -37
    5
}
