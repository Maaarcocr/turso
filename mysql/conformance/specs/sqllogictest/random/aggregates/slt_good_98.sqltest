test l90757 {
    SELECT DISTINCT + col0 AS col2 FROM tab1 AS cor0 WHERE NULL NOT IN ( 10 / col2 / - col2 + ( - 47 ) - + col2 * col0 * 49 );
}
expect unordered {
}

@setup s1
test l90901 {
    SELECT DISTINCT + COUNT( * ), 3 FROM tab0 WHERE NOT + col0 IS NULL;
}
