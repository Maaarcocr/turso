    SELECT + SUM( ( - - col0 ) ) AS col2 FROM tab1;
}
expect unordered {
    227
}

@setup s1
test l91434 {
    SELECT DISTINCT * FROM tab0 WHERE NOT + + 47 * col1 * - - 43 + - - 42 + - col2 <= + + col1 + - col1;
}
expect unordered {
    15|81|47
    87|21|10
    97|1|99
}
