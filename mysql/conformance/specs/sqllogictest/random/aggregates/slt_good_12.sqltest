    SELECT 77 + + col2 * + - col1 FROM tab1 AS cor0;
}
expect unordered {
    -1267
    -218
    -3119
}

@setup s1
test l92193 {
    SELECT DISTINCT - 16 * - col1 AS col0, + 8 AS col1, - 59 col2 FROM tab2 AS cor0;
}
expect unordered {
    1072|8|-59
    1232|8|-59
    816|8|-59
}
