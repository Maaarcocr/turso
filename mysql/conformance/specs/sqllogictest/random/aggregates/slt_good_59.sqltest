    SELECT MIN( 14 ) * + 66 * - ( - 71 ) AS col2 FROM tab2 AS cor0;
}
expect unordered {
    65604
}

@setup s1
test l90976 {
    SELECT - col2, + col0 AS col2 FROM tab0 AS cor0;
}
expect unordered {
    -10|87
    -47|15
    -99|97
}
