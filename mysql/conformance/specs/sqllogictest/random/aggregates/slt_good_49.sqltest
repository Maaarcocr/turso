    SELECT DISTINCT 20 + + - col1 + 65 + col1 FROM tab1 AS cor0;
}
expect unordered {
    85
}

@setup s1
test l89124 {
    SELECT DISTINCT * FROM tab0 AS cor0 WHERE NOT ( - + 90 ) IS NOT NULL;
}
expect unordered {
}

@setup s1
test l89402 {
    SELECT + - ( + - ( - + col1 ) ) col2 FROM tab1 AS cor0;
}
expect unordered {
    -14
    -47
    -5
}

@setup s1
test l90214 {
    SELECT DISTINCT - + 17 DIV + + COUNT( * ) AS col1 FROM tab0 AS cor0;
}
expect unordered {
    -5
}
