    SELECT DISTINCT - 58 + - col0 * + col1 * - - ( - + col0 ) col0 FROM tab2 AS cor0;
}
expect unordered {
    107858
    315334
    376817
}

@setup s1
test l90088 {
    SELECT + 37 * + + ( - + CAST( NULL AS SIGNED ) ) col1 FROM tab2;
}
expect unordered {
    NULL
    NULL
    NULL
}

@setup s1
test l90402 {
    SELECT + - COUNT( * ) AS col2 FROM tab2 cor0 CROSS JOIN tab0 AS cor1;
}
expect unordered {
    -9
}
