    SELECT ALL - 40 + + ( + - 99 ) AS col0 FROM tab2;
}
expect unordered {
    -139
    -139
    -139
}

@setup s1
test l89392 {
    SELECT DISTINCT + SUM( + col1 ) col1 FROM tab0 WHERE NOT - col1 IS NULL;
}
expect unordered {
    103
}

@setup s1
