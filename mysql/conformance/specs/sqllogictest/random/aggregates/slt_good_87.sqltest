@setup s1
test l88500 {
    SELECT + 43 + - COUNT( * ) AS col0 FROM tab0 WHERE NULL NOT BETWEEN col2 AND col0 / 82 / - col2 + - 81;
}
expect unordered {
    43
}

@setup s1
test l88558 {
    SELECT + 8 col1 FROM tab1 AS cor0;
}
expect unordered {
    8
    8
    8
}

@setup s1
test l88593 {
    SELECT ALL - col0, col1 AS col1 FROM tab1 AS cor0 WHERE + col0 = col1;
}
expect unordered {
}

@setup s1
test l88964 {
    SELECT DISTINCT * FROM tab1 WHERE NOT NULL IN ( 58 * col0 * col0 );
}
expect unordered {
}

@setup s1
test l89887 {
    SELECT ALL + col0 * - ( + + col0 ) AS col2 FROM tab1 AS cor0;
}
expect unordered {
    -2601
    -7225
    -8281
