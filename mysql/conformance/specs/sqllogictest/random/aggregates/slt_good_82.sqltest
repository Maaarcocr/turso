    SELECT * FROM tab0 WHERE - col2 >= ( + col2 );
}
expect unordered {
}

@setup s1
test l90709 {
    SELECT * FROM tab0 AS cor0 WHERE + 91 IS NOT NULL;
}
expect unordered {
    15|81|47
    87|21|10
    97|1|99
}

@setup s1
test l91104 {
    SELECT ALL + col0 * + - 38 + - 8 + + col1 FROM tab1;
}
expect unordered {
    -1932
    -3233
    -3419
}

@setup s1
test l91323 {
    SELECT - - ( + + col2 ) - col2 AS col0 FROM tab1 AS cor0;
}
expect unordered {
    0
    0
    0
}

@setup s1
test l91444 {
    SELECT ALL col1 FROM tab0 WHERE - ( - col2 ) IS NOT NULL;
}
expect unordered {
    1
    21
    81
}
