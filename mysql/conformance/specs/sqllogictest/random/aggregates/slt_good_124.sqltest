    SELECT DISTINCT - + ( + ( 58 ) ) col2 FROM tab2 cor0;
}
expect unordered {
    -58
}

@setup s1
test l90898 {
    SELECT DISTINCT + col1 + - col2 DIV + - col1 AS col0 FROM tab2 AS cor0;
}
expect unordered {
    51
    67
    77
}

@setup s1
test l90964 {
    SELECT - + ( + 57 ) + ( + 68 ) AS col2 FROM tab1 AS cor0;
}
expect unordered {
    11
    11
    11
}
