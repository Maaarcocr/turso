test l90876 {
    SELECT ALL + col2 + + ( col2 ), col1 FROM tab0 AS cor0;
}
expect unordered {
    198|1
    20|21
    94|81
}

@setup s1
test l91044 {
    SELECT col2 * + col1 * + + 31 AS col1 FROM tab1;
}
