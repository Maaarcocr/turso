}
expect unordered {
    66
    66
    66
}

@setup s1
test l88189 {
    SELECT ALL * FROM tab2 WHERE NOT + 70 <> - 21 / col2;
}
expect unordered {
}

@setup s1
test l88474 {
    SELECT ALL ( - CAST( NULL AS SIGNED ) ) AS col2 FROM tab2;
}
expect unordered {
    NULL
    NULL
    NULL
}

@setup s1
test l88489 {
    SELECT DISTINCT 28 * col1 FROM tab0;
}
expect unordered {
    2268
    28
    588
}

@setup s1
test l88948 {
    SELECT - 94 AS col2, - 69 FROM tab0 AS cor0;
}
expect unordered {
    -94|-69
    -94|-69
    -94|-69
}

@setup s1
test l89310 {
    SELECT DISTINCT + COUNT( * ) + COUNT( * ) AS col0 FROM tab1;
}
expect unordered {
    6
}

@setup s1
test l89462 {
    SELECT + 25 * + ( - 16 ) FROM tab2;
}
expect unordered {
    -400
    -400
    -400
}

@setup s1
test l90051 {
    SELECT DISTINCT 42 - col2 FROM tab0;
}
expect unordered {
    -5
    -57
    32
}

@setup s1
test l90244 {
    SELECT + col1 + 67 col0 FROM tab2;
}
expect unordered {
    118
    134
    144
}

@setup s1
test l90353 {
    SELECT + ( - 67 ) - + col0 AS col2 FROM tab0 AS cor0;
}
expect unordered {
    -154
    -164
    -82
}

@setup s1
test l90770 {
    SELECT DISTINCT - 51 DIV - + col0 FROM tab2;
}
expect unordered {
    0
    1
}
