    SELECT ALL * FROM tab2 AS cor0 CROSS JOIN tab1 cor1 WHERE NOT + 46 IS NULL;
}
expect unordered {
    46|51|23|51|14|96
    46|51|23|85|5|59
    46|51|23|91|47|68
    64|77|40|51|14|96
    64|77|40|85|5|59
    64|77|40|91|47|68
    75|67|58|51|14|96
    75|67|58|85|5|59
    75|67|58|91|47|68
}

@setup s1
test l90943 {
    SELECT DISTINCT - 38 * - col0 FROM tab0;
}
expect unordered {
    3306
    3686
    570
}

@setup s1
test l91222 {
    SELECT ALL - + ( col1 ) + - + col0 + + 45 AS col2 FROM tab0 WHERE ( NOT ( NOT NULL IS NULL ) );
}
expect unordered {
    -51
    -53
    -63
}
