    SELECT ALL * FROM tab0 WHERE NOT + - col2 * + - col0 * + col0 + - ( CAST( + col1 AS SIGNED ) ) / + 16 * - 77 + col1 IS NULL;
}
expect unordered {
    15|81|47
    87|21|10
    97|1|99
}

@setup s1
test l91127 {
    SELECT ALL - + 73 AS col2 FROM tab2 AS cor0 CROSS JOIN tab1 AS cor1;
}
expect unordered {
    -73
    -73
    -73
    -73
    -73
    -73
    -73
    -73
    -73
}
