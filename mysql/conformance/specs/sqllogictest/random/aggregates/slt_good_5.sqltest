    SELECT ALL - COUNT( DISTINCT + 30 ) AS col1 FROM tab1 AS cor0;
}
expect unordered {
    -1
}

@setup s1
test l91011 {
    SELECT DISTINCT + 3 * + MIN( - col2 ) FROM tab1 AS cor0;
}
expect unordered {
    -288
}
