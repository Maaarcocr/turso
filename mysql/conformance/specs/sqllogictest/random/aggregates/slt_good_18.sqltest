    SELECT ALL - col2 - 85 - col1 + + - col0 FROM tab0;
}
expect unordered {
    -203
    -228
    -282
}

@setup s1
test l89731 {
    SELECT ALL + 48 + + - COUNT( * ) + CAST( NULL AS SIGNED ) FROM tab2;
}
expect unordered {
    NULL
}

@setup s1
test l90045 {
    SELECT ALL MIN( - + col1 ) AS col0 FROM tab2 AS cor0;
}
expect unordered {
    -77
}

@setup s1
test l91059 {
    SELECT * FROM tab1 cor0 WHERE ( NOT col0 IS NOT NULL );
}
expect unordered {
}
