    SELECT DISTINCT + 31 + - - col2 FROM tab1 AS cor0;
}
expect unordered {
    127
    90
    99
}

@setup s1
test l90443 {
    SELECT - col0 AS col2, + CAST( NULL AS SIGNED ) FROM tab0;
}
expect unordered {
    -15|NULL
    -87|NULL
    -97|NULL
}
