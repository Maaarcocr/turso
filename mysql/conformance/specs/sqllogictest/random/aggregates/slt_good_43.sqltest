    SELECT DISTINCT COUNT( * ) + - - MAX( DISTINCT col2 ) AS col0 FROM tab2 AS cor0;
}
expect unordered {
    61
}

@setup s1
test l89887 {
    SELECT * FROM tab0 AS cor0 WHERE col0 BETWEEN NULL AND NULL;
}
expect unordered {
}

@setup s1
test l90064 {
    SELECT + MAX( col1 ) * + + 59 + + 33 + SUM( DISTINCT col2 ) FROM tab1 cor0;
}
expect unordered {
    3029
}

@setup s1
test l90321 {
    SELECT ALL COUNT( * ) FROM tab1 AS cor0 WHERE - 48 NOT BETWEEN - col1 + - - 84 AND NULL;
}
expect unordered {
    3
}

@setup s1
test l90443 {
    SELECT DISTINCT - + CAST( + col2 AS SIGNED ) + - + col1 * - col0 FROM tab2 cor0;
}
expect unordered {
    2323
    4888
    4967
}

@setup s1
test l90474 {
    SELECT DISTINCT + + 28 AS col0 FROM tab0 AS cor0;
}
expect unordered {
    28
}

@setup s1
test l90738 {
    SELECT ALL 90 FROM tab2 WHERE NOT NULL = NULL;
}
expect unordered {
}
