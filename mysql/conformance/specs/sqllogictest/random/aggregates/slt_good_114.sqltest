}
expect unordered {
    66
}

@setup s1
test l91002 {
    SELECT ALL - - col0 + - - col0 FROM tab1 cor0 WHERE col1 IS NULL;
}
expect unordered {
}

@setup s1
test l91043 {
    SELECT DISTINCT + 88 - - col2 + + ( + ( + - 77 ) ) FROM tab2;
}
expect unordered {
    34
    51
    69
}

@setup s1
test l91456 {
    SELECT col0 AS col2, + col1 * col0 DIV - col1 FROM tab1 cor0;
}
expect unordered {
    51|-51
    85|-85
    91|-91
}

@setup s1
test l91511 {
    SELECT ALL 98 DIV + - col2 + + col1 FROM tab2 AS cor0;
}
expect unordered {
    47
    66
    75
}
