    SELECT COUNT( ALL + 22 ) AS col2 FROM tab1 WHERE col0 + + - 98 IS NULL;
}
expect unordered {
    0
}

@setup s1
test l91240 {
    SELECT DISTINCT CAST( 30 AS SIGNED ) + - CAST( - col1 AS SIGNED ) FROM tab1 AS cor0;
}
expect unordered {
    35
    44
    77
}

@setup s1
test l91307 {
    SELECT 36 DIV 25 * + + COUNT( * ) - - 21 FROM tab1;
}
expect unordered {
    24
}

@setup s1
test l91589 {
    SELECT DISTINCT * FROM tab1 WHERE - ( + ( - - col0 ) ) * + 63 IS NULL;
}
expect unordered {
}

@setup s1
test l91785 {
    SELECT ALL - col2, col2 DIV - 49 * + - col1 AS col2 FROM tab0;
}
expect unordered {
    -10|0
    -47|0
    -99|2
}
