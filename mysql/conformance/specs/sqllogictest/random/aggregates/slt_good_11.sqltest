test l90344 {
    SELECT ALL + + col0 + 44 * col2 FROM tab1 AS cor0;
}
expect unordered {
    2681
    3083
    4275
}

@setup s1
test l90959 {
    SELECT ALL + COUNT( ALL + col2 ) AS col0 FROM tab2 AS cor0;
}
expect unordered {
    3
}

@setup s1
test l91129 {
    SELECT DISTINCT + col2 * + col1 AS col1, col0 + - ( - col1 ) AS col0 FROM tab2;
}
expect unordered {
    1173|97
    3080|141
    3886|142
}
