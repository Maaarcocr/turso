test l81007 {
    SELECT DISTINCT col2 - + col0 FROM tab2;
}
expect unordered {
    -41
    -52
    20
}

@setup s1
test l81527 {
    SELECT + cor0.col1 * - 25 AS col1 FROM tab1 AS cor0;
}
expect unordered {
    -250
    -325
    -650
}
