    SELECT DISTINCT ( 85 ) * col1 AS col2 FROM tab2 AS cor0;
}
expect unordered {
    1445
    2635
    5015
}

@setup s1
test l76492 {
    SELECT DISTINCT + col1 + ( + col1 ) FROM tab2;
}
expect unordered {
    118
    34
    62
}

@setup s1
test l77305 {
