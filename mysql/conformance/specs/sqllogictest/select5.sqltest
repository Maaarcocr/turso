@setup s1
test l2395 {
    SELECT x29,x31,x51,x55
  FROM t51,t31,t29,t55
 WHERE b55=a31
   AND a29=6
   AND a29=b51
   AND a51=b31;
}
expect unordered {
    table t29 row 6|table t31 row 9|table t51 row 5|table t55 row 4
}

@setup s1
test l2447 {
    SELECT x61,x29,x6,x36
  FROM t61,t29,t6,t36
 WHERE b36=a61
   AND a6=b61
   AND a36=b29
   AND a6=6;
}
expect unordered {
    table t61 row 10|table t29 row 5|table t6 row 6|table t36 row 10
}

@setup s1
test l2630 {
    SELECT x34,x50,x16,x12,x24
  FROM t50,t12,t34,t24,t16
 WHERE b16=a34
   AND a34=9
   AND b12=a16
   AND b50=a24
   AND b24=a12;
}
expect unordered {
    table t34 row 9|table t50 row 3|table t16 row 6|table t12 row 4|table t24 row 6
}

@setup s1
test l2824 {
    SELECT x37,x45,x6,x17,x41,x57
  FROM t57,t41,t45,t6,t37,t17
 WHERE a37=2
   AND a57=b17
   AND b41=a45
   AND b6=a37
   AND a6=b45
   AND a41=b57;
}
expect unordered {
    table t37 row 2|table t45 row 9|table t6 row 1|table t17 row 2|table t41 row 5|table t57 row 2
}

@setup s1
test l3179 {
    SELECT x22,x44,x30,x36,x48,x27,x2,x57
  FROM t57,t44,t30,t22,t2,t36,t27,t48
 WHERE a57=7
   AND a48=b30
   AND b48=a57
   AND b27=a22
   AND b22=a36
   AND a27=b44
   AND a30=b36
   AND a44=b2;
}
expect unordered {
    table t22 row 7|table t44 row 10|table t30 row 5|table t36 row 9|table t48 row 7|table t27 row 4|table t2 row 6|table t57 row 7
}

@setup s1
test l3242 {
    SELECT x15,x32,x36,x64,x46,x54,x45,x57
  FROM t54,t57,t46,t15,t64,t36,t45,t32
 WHERE b57=a36
   AND b32=a46
   AND b64=a32
   AND b54=a57
   AND a36=3
   AND a45=b46
   AND b15=a54
   AND b45=a15;
}
expect unordered {
    table t15 row 2|table t32 row 6|table t36 row 3|table t64 row 3|table t46 row 1|table t54 row 1|table t45 row 1|table t57 row 6
}

@setup s1
test l3539 {
    SELECT x52,x40,x41,x2,x58,x14,x31,x19,x10
  FROM t19,t31,t2,t14,t41,t10,t40,t52,t58
 WHERE a14=5
   AND b40=a14
   AND b58=a41
   AND b2=a10
   AND a40=b19
   AND a31=b41
   AND b10=a58
   AND b31=a52
   AND b52=a19;
}
expect unordered {
    table t52 row 5|table t40 row 6|table t41 row 5|table t2 row 4|table t58 row 7|table t14 row 5|table t31 row 9|table t19 row 4|table t10 row 3
}

@setup s1
test l3812 {
    SELECT x32,x7,x37,x60,x29,x58,x62,x17,x4,x22,x53
  FROM t17,t37,t4,t60,t7,t22,t32,t53,t58,t62,t29
 WHERE a37=b22
   AND a60=b4
   AND a53=b60
   AND b32=a4
   AND b53=a62
   AND b37=a32
   AND a58=b7
   AND a17=b62
   AND a29=10
   AND b17=a29
   AND a22=b58;
}
expect unordered {
    table t32 row 10|table t7 row 4|table t37 row 9|table t60 row 5|table t29 row 10|table t58 row 9|table t62 row 1|table t17 row 10|table t4 row 8|table t22 row 7|table t53 row 5
}

@setup s1
test l3931 {
    SELECT x24,x31,x40,x52,x64,x19,x30,x15,x54,x5,x46
  FROM t52,t30,t19,t46,t40,t54,t24,t31,t15,t64,t5
 WHERE a40=b64
   AND b31=a52
   AND a31=b24
   AND a15=b52
   AND b5=a46
   AND a64=b15
   AND a30=b40
   AND a19=3
   AND a19=b54
   AND b46=a24
   AND b30=a54;
