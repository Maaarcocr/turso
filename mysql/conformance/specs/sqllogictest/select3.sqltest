@setup s1
test l196 {
    SELECT a+b*2+c*3+d*4+e*5,
       CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
        WHEN a<b+3 THEN 333 ELSE 444 END,
       abs(b-c),
       (a+b+c+d+e)/5,
       a+b*2+c*3
  FROM t1
 WHERE (e>c OR e<d)
   AND d>e
   AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
 ORDER BY 3,2,1,5;
}
expect unordered {
    1902|222|4|127.0000|760
    1985|333|4|132.0000|793
    2046|222|2|137.0000|827
    2432|444|1|162.0000|966
    2728|333|3|182.0000|1096
    3175|333|3|212.0000|1277
    3331|222|1|222.0000|1338
    3473|333|1|232.0000|1391
    3706|111|2|247.0000|1484
    NULL|444|1|NULL|NULL
    NULL|444|NULL|NULL|NULL
}

