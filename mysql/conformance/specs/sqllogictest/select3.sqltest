    376|1121|2
    398|1180|-1
    426|1277|2
    458|1360|-1
    468|1391|-2
    486|1455|NULL
}

@setup s1
test l4255 {
    SELECT CASE a+1 WHEN b THEN 111 WHEN c THEN 222
        WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
       a+b*2+c*3,
       a+b*2+c*3+d*4,
